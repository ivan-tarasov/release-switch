# Copy to projects/<project>.env and edit. Plain KEY=value lines, read by bash.
# Env vars of the same name win over these.

DEPLOY_BASE="$HOME/domains/example.com/www"
CHECK_URL="https://example.com/"

# Optional.
#REPO_URL="git@github.com:owner/repo.git"   # defaults to the origin of current
#DEPLOY_BRANCH=develop
#KEEP_RELEASES=5                              # 2 or more
#CHECK_WAIT=150
#CHECK_VERSION=1
#RELEASE_WAIT=90                              # 0 to never wait for a release tag
#PHP_BIN=/usr/local/bin/ea-php84
#COMPOSER_BIN="/usr/local/bin/ea-php84 $HOME/composer.phar"
#PHP_RELOAD_CMD="touch $HOME/tmp/restart.txt"
#DISPLAY_TZ=America/Toronto

# Staging slots s1..sN, each in the domain folder next to production (see README, Staging).
#STAGING_SERVERS=2
#STAGING_URL="https://{slot}.example.com/"   # defaults to sN. before the host of CHECK_URL

# Alerts on failed deploys, rollbacks and check results that change. Either or both.
#NOTIFY_URL="https://hooks.example.com/..."   # gets JSON with a "text" field (Slack-style)
#NOTIFY_CMD='printf "%s\n" "$NOTIFY_TEXT" | mail -s "deploy alert" you@example.com'
#NOTIFY_ON=problems                           # or all, to also send successful deploys

#!/usr/bin/env bash
#
# Zero-downtime deploys with release folders. Runs on the server. See README.md.
#
#   deploy [project[@sN]] [deploy [--ref <ref>] [--branch <name>] [--pr <number>] [--force] [--no-wait] [--yes]
#                     | freeze [reason] | down [reason] [--yes] | up
#                     | unfreeze | status | check | log [count] | path [--base] | rollback [name] [--yes]
#                     | init <checkout> [--dry-run] | slots [update] | stage <branch> | stage --pr <number>
#                     | free | copy-from <project> [--yes] [path ...] | help [command]]
#   deploy self-update | self [log [count]] | --version
#   deploy [project] <command> --help

set -euo pipefail

# Variables set before the engine starts: the environment and bash's own. deploy.conf may set them.
START_VARS=" $(compgen -v | tr '\n' ' ')"

ENGINE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECTS_DIR="${PROJECTS_DIR:-$ENGINE_DIR/projects}"

# Settings a project file may set. Env vars of the same name win.
SETTINGS=(DEPLOY_BASE CHECK_URL REPO_URL DEPLOY_BRANCH KEEP_RELEASES CHECK_WAIT CHECK_VERSION RELEASE_WAIT
    PHP_BIN COMPOSER_BIN PHP_RELOAD_CMD OPCACHE_RESET_DIR DISPLAY_TZ NOTIFY_URL NOTIFY_CMD NOTIFY_ON STAGING_SERVERS STAGING_URL
    STEP_TIMEOUT DISK_LIMIT MIN_FREE_MB MIGRATIONS_DIR)

PROJECT=""

# The staging slot (s1, s2, ...) from <project>@sN, empty in production, and the branch it follows.
# SLOT_PR is the pull request number when the slot follows one (its BRANCH file holds pr/<N>).
DEPLOY_SLOT=""
SLOT_BRANCH=""
SLOT_PR=""

# The production folder and DEPLOY_BRANCH of a slot's project, set by apply_slot. A free slot
# deploys that branch.
PROD_BASE=""
PROD_DEPLOY_BRANCH=""

# The temp copy copy-from is writing, so on_exit removes it when the run stops.
COPY_TMP=""

# The one-time OPcache reset file while it is in the web root, so on_exit deletes it.
OPCACHE_FILE=""

# While the project menu is up: its temp folder, the jobs reading its rows, and the terminal
# settings to restore. on_exit cleans them up.
MENU_TMP=""
MENU_PIDS=""
MENU_STTY=""

# Set while a deploy runs, so the exit trap knows what to clean up.
NEW_RELEASE=""
PREVIOUS_RELEASE=""
SWITCHED=0
LOCK_DIR=""
LOCK_BREAK=""
RELEASE_DIR=""
RELEASE_NAME=""
SHARED=()
COPY_FROM_LIVE=()

# For deploy.log: what runs, on which release, and the stage it has reached.
ACTION=""
LOG_RELEASE=""
STAGE=""
STARTED="$(date +%s)"
LOG_WARNED=0

# The process group run_limited is running, and its watchdog, so on_exit can stop them.
LIMIT_PID=""
LIMIT_DOG=""
# 1 while run_limited keeps the real stderr in fd 4.
LIMIT_FD=0

# The last fail() message, for the alert.
FAIL_MESSAGE=""

# The engine's functions, set in main. deploy.conf may not define any of them.
ENGINE_FUNCS=""

# 1 with --yes or -y: rollback, down and deploy --force do not ask.
YES=0

# The commands, for help and for typo hints.
COMMANDS=(deploy freeze unfreeze down up status check log path rollback slots stage staging free copy-from init self
    help version)

# The staging subcommands, for help and for typo hints.
STAGING_COMMANDS=(checkout update free copy-from status log path rollback down up)

# The old form of a staging command, set by staging_args.
STAGING_ARGS=()

# The commits a deploy ships, "<full sha> <subject>" per line, newest first. Empty when unknown
# or none.
SHIPPED=""

# What steps and NOTIFY_CMD know about the run, set as soon as known; empty when unknown. The sha,
# author and message are those of the release being deployed or rolled back to.
DEPLOY_SHA=""
DEPLOY_REF=""
DEPLOY_PREVIOUS_RELEASE=""
DEPLOY_AUTHOR=""
DEPLOY_MESSAGE=""
DEPLOY_PERFORMER="${USER:-$(id -un 2>/dev/null || true)}"
DEPLOY_FORCED=0
export DEPLOY_SHA DEPLOY_REF DEPLOY_PREVIOUS_RELEASE DEPLOY_AUTHOR DEPLOY_MESSAGE DEPLOY_PERFORMER DEPLOY_FORCED

# Rails like Clack's (┌ ◇ │ └) when stdout is a terminal, or with DEPLOY_RAILS=1. Pipes and cron
# get plain lines. Colors only on a terminal, and never with NO_COLOR.
RAILS=0
if [ "${DEPLOY_RAILS:-}" = 1 ] || { [ -t 1 ] && [ "${DEPLOY_RAILS:-}" != 0 ]; }; then
    RAILS=1
fi

C_DIM="" C_BOLD="" C_GREEN="" C_RED="" C_YELLOW="" C_OFF=""
if [ "$RAILS" -eq 1 ] && [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_DIM=$'\e[2m' C_BOLD=$'\e[1m' C_GREEN=$'\e[32m' C_RED=$'\e[31m' C_YELLOW=$'\e[33m' C_OFF=$'\e[0m'
fi

# 1 once intro has opened the rails, so on_exit closes them.
INTRO=0

# 1 while the release tag wait line is open on a terminal, so later output starts on a new line.
WAIT_LINE=0

# Hides the user and password in URLs: https://user:token@host becomes https://***@host.
# ssh://git@host stays, as git@ holds no secret.
redact() {
    case "$1" in
        *://*@*) printf '%s' "$1" | sed -E $'s#://git@#://\001#g; s#://[^/@[:space:]]+@#://***@#g; s#://\001#://git@#g' ;;
        *) printf '%s' "$1" ;;
    esac
}

say() {
    local text
    text="$(redact "$*")"

    if [ "$RAILS" -eq 1 ]; then
        printf '%s◇%s  %s\n' "$C_GREEN" "$C_OFF" "$text"
    else
        printf '==> %s\n' "$text"
    fi
}

warn() {
    local text
    text="$(redact "$*")"

    if [ "$RAILS" -eq 1 ]; then
        printf '%s▲%s  %s\n' "$C_YELLOW" "$C_OFF" "$text" >&2
    else
        printf 'deploy: %s\n' "$text" >&2
    fi
}

fail() {
    FAIL_MESSAGE="$(redact "$*")"
    error_line "$FAIL_MESSAGE"

    exit 1
}

error_line() {
    if [ "$RAILS" -eq 1 ]; then
        printf '%s■%s  %s\n' "$C_RED" "$C_OFF" "$1" >&2
    else
        printf 'deploy: %s\n' "$1" >&2
    fi
}

is_terminal() {
    [ -t 0 ] && [ -t 1 ]
}

# Asks $1 with [y/N] on the terminal. True only for y or yes.
ask_yes() {
    local answer

    printf '%s' "$(say "$1 [y/N] ")"
    read -r answer || answer=""

    case "$answer" in
        y | Y | yes | YES) return 0 ;;
    esac

    return 1
}

# Before a risky change: on a terminal and without --yes, shows the lines after $1, asks $1 and
# stops with 0 on no. Without a terminal (cron, pipes) it goes on, silent.
confirm() {
    local question="$1" line
    shift

    if [ "$YES" -eq 1 ] || ! is_terminal; then
        return 0
    fi

    for line in "$@"; do
        say "$line"
    done

    ask_yes "$question" && return 0

    say "Nothing done"
    exit 0
}

# Puts each line of its input on the rail.
rail() {
    local line

    if [ "$RAILS" -eq 0 ]; then
        cat

        return
    fi

    while IFS= read -r line || [ -n "$line" ]; do
        printf '%s│%s  %s\n' "$C_DIM" "$C_OFF" "$line"
    done
}

# The newest release tag of the engine (or of commit $1), "+N" when N commits are past it, or the
# short sha.
engine_version() {
    local described

    if described="$(git -C "$ENGINE_DIR" describe --tags --match 'v[0-9]*' "${1:-HEAD}" 2>/dev/null)"; then
        printf '%s' "$described" | sed -E 's/-([0-9]+)-g[0-9a-f]+$/+\1/'
    else
        git -C "$ENGINE_DIR" rev-parse --short "${1:-HEAD}" 2>/dev/null || printf 'unknown'
    fi
}

# Opens the rails: "┌  release-switch v2026.11.1 · tarasov · deploy".
intro() {
    [ "$RAILS" -eq 1 ] || return 0
    printf '%s┌%s  %srelease-switch%s %s%s%s%s\n%s│%s\n' "$C_DIM" "$C_OFF" "$C_BOLD" "$C_OFF" "$C_DIM" \
        "$(engine_version)" "$C_OFF" "${1:+ · $1}" "$C_DIM" "$C_OFF"
    INTRO=1
}

outro() {
    local seconds
    [ "$INTRO" -eq 1 ] || return 0
    seconds="$(($(date +%s) - STARTED))"

    if [ "$1" -eq 0 ]; then
        printf '%s│%s\n%s└%s  Done in %ss\n' "$C_DIM" "$C_OFF" "$C_DIM" "$C_OFF" "$seconds"
    else
        printf '%s│%s\n%s└%s  %sFailed%s after %ss\n' "$C_DIM" "$C_OFF" "$C_DIM" "$C_OFF" "$C_RED" "$C_OFF" "$seconds"
    fi
}

# Runs a command that only reports (status, check, log). On the rails, its output and errors go on
# the rail; elsewhere it runs as is.
report() {
    local title="$1" status
    shift

    if [ "$RAILS" -eq 0 ]; then
        "$@"

        return
    fi

    intro "$title"
    set +e
    (
        set -e
        "$@"
    ) 2>&1 | rail
    status="${PIPESTATUS[0]}"
    set -e

    return "$status"
}

# Project names, from projects/<name>.env.
list_projects() {
    local file

    for file in "$PROJECTS_DIR"/*.env; do
        [ -f "$file" ] || continue
        file="$(basename "$file" .env)"
        [ "$file" = example ] || printf '%s\n' "$file"
    done
}

# True when $1 names a project file, with or without a slot: tarasov or tarasov@s1.
is_project() {
    [ -f "$PROJECTS_DIR/${1%%@*}.env" ]
}

# Reads projects/<name>.env for <name> or <name>@sN, keeping any setting already set as an env var.
load_project() {
    local name kept_names=() kept_values=() i
    PROJECT="${1%%@*}"
    DEPLOY_SLOT=""

    case "$1" in
        *@*)
            DEPLOY_SLOT="${1#*@}"
            [[ "$DEPLOY_SLOT" =~ ^s[1-9][0-9]*$ ]] \
                || fail "'$DEPLOY_SLOT' is not a staging slot; use $PROJECT@s1, $PROJECT@s2, ..."
            ;;
    esac

    for name in "${SETTINGS[@]}"; do
        if [ -n "${!name+x}" ]; then
            kept_names+=("$name")
            kept_values+=("${!name}")
        fi
    done

    # shellcheck source=/dev/null
    . "$PROJECTS_DIR/$PROJECT.env"

    # The +-forms keep empty arrays safe under `set -u` in bash 3.2 (macOS).
    for i in ${kept_names[@]+"${!kept_names[@]}"}; do
        printf -v "${kept_names[$i]}" '%s' "${kept_values[$i]}"
    done
}

apply_defaults() {
    DEPLOY_BASE="${DEPLOY_BASE:-}"
    CHECK_URL="${CHECK_URL:-}"
    REPO_URL="${REPO_URL:-}"
    DEPLOY_BRANCH="${DEPLOY_BRANCH:-develop}"
    KEEP_RELEASES="${KEEP_RELEASES:-5}"
    CHECK_WAIT="${CHECK_WAIT:-150}"
    CHECK_VERSION="${CHECK_VERSION:-1}"
    RELEASE_WAIT="${RELEASE_WAIT:-90}"
    PHP_BIN="${PHP_BIN:-php}"
    COMPOSER_BIN="${COMPOSER_BIN:-composer}"
    PHP_RELOAD_CMD="${PHP_RELOAD_CMD:-}"
    OPCACHE_RESET_DIR="${OPCACHE_RESET_DIR:-}"
    DISPLAY_TZ="${DISPLAY_TZ:-}"
    NOTIFY_URL="${NOTIFY_URL:-}"
    NOTIFY_CMD="${NOTIFY_CMD:-}"
    NOTIFY_ON="${NOTIFY_ON:-problems}"
    STAGING_SERVERS="${STAGING_SERVERS:-0}"
    STAGING_URL="${STAGING_URL:-}"
    STEP_TIMEOUT="${STEP_TIMEOUT:-600}"
    DISK_LIMIT="${DISK_LIMIT:-}"
    MIN_FREE_MB="${MIN_FREE_MB:-500}"
    # No colon: an empty value turns the migrations hint off.
    MIGRATIONS_DIR="${MIGRATIONS_DIR-database/migrations}"

    case "$KEEP_RELEASES" in
        '' | *[!0-9]*) fail "KEEP_RELEASES must be a whole number, not '$KEEP_RELEASES'" ;;
    esac
    case "$CHECK_WAIT" in
        '' | *[!0-9]*) fail "CHECK_WAIT must be a whole number of seconds, not '$CHECK_WAIT'" ;;
    esac
    case "$RELEASE_WAIT" in
        '' | *[!0-9]*) fail "RELEASE_WAIT must be a whole number of seconds, not '$RELEASE_WAIT'" ;;
    esac
    case "$STAGING_SERVERS" in
        '' | *[!0-9]*) fail "STAGING_SERVERS must be a whole number, not '$STAGING_SERVERS'" ;;
    esac
    case "$STEP_TIMEOUT" in
        '' | *[!0-9]*) fail "STEP_TIMEOUT must be a whole number of seconds, not '$STEP_TIMEOUT'" ;;
    esac
    case "$MIN_FREE_MB" in
        '' | *[!0-9]*) fail "MIN_FREE_MB must be a whole number of megabytes, not '$MIN_FREE_MB'" ;;
    esac
    case "$OPCACHE_RESET_DIR" in
        /* | .. | ../* | */.. | */../*)
            fail "OPCACHE_RESET_DIR must be a folder inside the release, like public, not '$OPCACHE_RESET_DIR'"
            ;;
    esac
    case "/$MIGRATIONS_DIR/" in
        //) ;;
        //* | */../*) fail "MIGRATIONS_DIR must stay inside the release: no leading / and no .., not '$MIGRATIONS_DIR'" ;;
    esac
    [ -z "$DISK_LIMIT" ] || [[ "$DISK_LIMIT" =~ ^[0-9]+([.][0-9]+)?[KkMmGgTt]?$ ]] \
        || fail "DISK_LIMIT must be a size like 2G, 500M or 1.5G, or plain bytes, not '$DISK_LIMIT'"
    # 10# drops leading zeros, which bash math reads as octal.
    KEEP_RELEASES=$((10#$KEEP_RELEASES))
    CHECK_WAIT=$((10#$CHECK_WAIT))
    RELEASE_WAIT=$((10#$RELEASE_WAIT))
    STAGING_SERVERS=$((10#$STAGING_SERVERS))
    STEP_TIMEOUT=$((10#$STEP_TIMEOUT))
    MIN_FREE_MB=$((10#$MIN_FREE_MB))
    [ "$KEEP_RELEASES" -ge 2 ] \
        || fail "KEEP_RELEASES must be 2 or more: the live release and one to roll back to"

    DEPLOY_HOST="$(host_of_url "$CHECK_URL")"
    export DEPLOY_BASE PHP_BIN COMPOSER_BIN DEPLOY_SLOT DEPLOY_HOST
}

# The host of URL $1, without scheme, user, port or path: https://u:p@example.com:8443/x gives example.com.
host_of_url() {
    printf '%s' "$1" | sed -E 's|^[^:/]+://||; s|[/?#].*$||; s|^.*@||; s|:[0-9]*$||'
}

# Turns the production settings into those of the slot in DEPLOY_SLOT: its own folder next to
# production, its own URL, 2 releases, no tag wait and no alerts.
apply_slot() {
    local prod_base pattern='{slot}'

    [ "$STAGING_SERVERS" -gt 0 ] \
        || fail "$PROJECT has no staging slots (set STAGING_SERVERS in $PROJECTS_DIR/$PROJECT.env)"
    [ "${DEPLOY_SLOT#s}" -le "$STAGING_SERVERS" ] \
        || fail "$PROJECT has no $DEPLOY_SLOT; its slots are s1 to s$STAGING_SERVERS (STAGING_SERVERS=$STAGING_SERVERS)"
    [ -n "$DEPLOY_BASE" ] || fail "set DEPLOY_BASE in $PROJECTS_DIR/$PROJECT.env"

    prod_base="${DEPLOY_BASE%/}"
    PROD_BASE="$prod_base"
    DEPLOY_BASE="$(dirname "$prod_base")/$DEPLOY_SLOT"
    [ "$DEPLOY_BASE" != "$prod_base" ] \
        || fail "$DEPLOY_SLOT would share the production folder $prod_base; give production a folder of its own"

    # The first deploy of a slot clones what production runs.
    if [ -z "$REPO_URL" ]; then
        REPO_URL="$(git -C "$prod_base/current" remote get-url origin 2>/dev/null || true)"
    fi

    if [ -n "$STAGING_URL" ]; then
        CHECK_URL="${STAGING_URL//"$pattern"/$DEPLOY_SLOT}"
    elif [ -n "$CHECK_URL" ]; then
        case "$CHECK_URL" in
            *://*) ;;
            *) fail "cannot find the host in CHECK_URL; set STAGING_URL with {slot}" ;;
        esac
        CHECK_URL="$(printf '%s' "$CHECK_URL" | sed -E "s|^([^:/]+://([^/@]*@)?)|\\1$DEPLOY_SLOT.|")"
    fi

    KEEP_RELEASES=2
    RELEASE_WAIT=0
    NOTIFY_URL=""
    NOTIFY_CMD=""
    SLOT_BRANCH=""
    SLOT_PR=""

    PROD_DEPLOY_BRANCH="$DEPLOY_BRANCH"

    if [ -f "$DEPLOY_BASE/BRANCH" ]; then
        SLOT_BRANCH="$(cat "$DEPLOY_BASE/BRANCH")"
        DEPLOY_BRANCH="$SLOT_BRANCH"
        ! is_pr_branch "$SLOT_BRANCH" || SLOT_PR="${SLOT_BRANCH#pr/}"
    fi

    PROJECT="$PROJECT@$DEPLOY_SLOT"
    DEPLOY_HOST="$(host_of_url "$CHECK_URL")"
    export DEPLOY_BASE DEPLOY_SLOT DEPLOY_HOST
}

# True when a slot branch $1 names a pull request: pr/<N>.
is_pr_branch() {
    [[ "$1" =~ ^pr/[1-9][0-9]*$ ]]
}

# The remote ref of DEPLOY_BRANCH: refs/pull/<N>/head when the slot follows a pull request.
branch_ref() {
    if [ -n "$SLOT_PR" ]; then
        printf 'refs/pull/%s/head' "$SLOT_PR"
    else
        printf 'refs/heads/%s' "$DEPLOY_BRANCH"
    fi
}

# DEPLOY_BRANCH for people: "PR #7" for a pull request.
branch_label() {
    if [ -n "$SLOT_PR" ]; then
        printf 'PR #%s' "$SLOT_PR"
    else
        printf '%s' "$DEPLOY_BRANCH"
    fi
}

# A commits-only clone of DEPLOY_BRANCH from repo $1 into $2, with HEAD at its tip. A clone never
# fetches refs/pull/*, so a pull request head is fetched on its own.
history_clone() {
    if [ -z "$SLOT_PR" ]; then
        git clone --quiet --bare --filter=tree:0 --single-branch --branch "$DEPLOY_BRANCH" "$1" "$2" 2>/dev/null

        return
    fi

    git clone --quiet --bare --filter=tree:0 --single-branch "$1" "$2" 2>/dev/null \
        && git -C "$2" fetch --quiet origin "+$(branch_ref):refs/heads/deploy-pr" 2>/dev/null \
        && git -C "$2" symbolic-ref HEAD refs/heads/deploy-pr
}

resolve_base() {
    [ -n "$DEPLOY_BASE" ] || fail "set DEPLOY_BASE in $PROJECTS_DIR/<project>.env"

    mkdir -p "$DEPLOY_BASE"
    DEPLOY_BASE="$(cd "$DEPLOY_BASE" && pwd -P)"
}

# A real folder at current (a web panel makes one for a new document root) would get the release
# link inside it, and the site would never serve the release.
refuse_current_folder() {
    [ ! -e "$DEPLOY_BASE/current" ] || [ -L "$DEPLOY_BASE/current" ] \
        || fail "$DEPLOY_BASE/current is a folder, not a link; move it away (a web panel may have made it for the document root)"
}

# Who holds the lock in folder $1 (default: the lock): "<pid> <start, epoch seconds> <action>".
# Empty if nobody does, or the owner file is not written yet.
lock_owner() {
    cat "${1:-$DEPLOY_BASE/.deploy.lock}/owner" 2>/dev/null || true
}

# Seconds since the lock folder $1 was made. PHP, as stat and date differ between GNU and BSD.
lock_age() {
    # shellcheck disable=SC2016 # PHP code, not shell.
    "$PHP_BIN" -r '$t = @filemtime($argv[1]); echo $t === false ? 0 : max(0, time() - $t);' "$1"
}

# One of: free, stale, held. Stale: its process is gone, or it has had no owner for 60 s (the run
# died while taking it). With no owner before that, a run is still taking it: held.
lock_state() {
    local dir="${1:-$DEPLOY_BASE/.deploy.lock}" pid

    if [ ! -d "$dir" ]; then
        printf 'free\n'

        return
    fi

    pid="$(lock_owner "$dir" | cut -d' ' -f1)"

    if [ -n "$pid" ]; then
        if ps -p "$pid" > /dev/null 2>&1; then
            printf 'held\n'
        else
            printf 'stale\n'
        fi
    elif [ "$(lock_age "$dir")" -ge 60 ]; then
        printf 'stale\n'
    else
        printf 'held\n'
    fi
}

# "PID 123, deploy, 4 min", or "no owner, 12 s old" for folder $1 (default: the lock).
lock_text() {
    local dir="${1:-$DEPLOY_BASE/.deploy.lock}" pid started action

    read -r pid started action <<< "$(lock_owner "$dir")"

    if [ -z "${pid:-}" ]; then
        printf 'no owner, %s s old' "$(lock_age "$dir")"

        return
    fi

    printf 'PID %s, %s, %s min' "$pid" "${action:-unknown}" "$((($(date +%s) - ${started:-0}) / 60))"
}

# Takes the lock for $1 (deploy, rollback, down or up). A stale lock is removed first.
acquire_lock() {
    local state

    # stage took it already, for this slot.
    [ "$LOCK_DIR" != "$DEPLOY_BASE/.deploy.lock" ] || return 0
    LOCK_DIR="$DEPLOY_BASE/.deploy.lock"

    # mkdir is atomic, and unlike flock it exists everywhere.
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        state="$(lock_state)"

        # Only one run at a time removes a stale lock: the one that makes the break folder. The
        # others fail, as that run is about to take the lock.
        if [ "$state" = stale ] && mkdir "$LOCK_DIR.break" 2>/dev/null; then
            LOCK_BREAK="$LOCK_DIR.break"

            # Checked again: another run may have replaced the lock since. While this run holds
            # the break folder, nobody else removes a lock, so a stale one stays the same.
            if [ "$(lock_state)" = stale ]; then
                say "Removing a stale lock: $(lock_text | sed -E 's/^PID ([0-9]+).*/PID \1 is gone/')"
                # Moved aside first, so the path frees at once and other runs never see half of it.
                rm -rf "$LOCK_DIR.stale.$$"
                mv "$LOCK_DIR" "$LOCK_DIR.stale.$$" 2>/dev/null || true
                rm -rf "$LOCK_DIR.stale.$$"
            fi
        elif [ "$state" = stale ] && [ "$(lock_age "$LOCK_DIR.break")" -ge 60 ]; then
            LOCK_DIR=""
            fail "a stale lock removal stopped half way; remove $DEPLOY_BASE/.deploy.lock.break and $DEPLOY_BASE/.deploy.lock if no deploy is running"
        fi

        if ! mkdir "$LOCK_DIR" 2>/dev/null; then
            LOCK_DIR=""
            release_lock_break
            fail "another deploy is running ($(lock_text)); remove $DEPLOY_BASE/.deploy.lock if it is not"
        fi

        release_lock_break
    fi

    # Written aside and renamed, so the owner file is never half written.
    if ! printf '%s %s %s\n' "$$" "$(date +%s)" "$1" 2>/dev/null > "$LOCK_DIR/owner.$$" \
        || ! mv "$LOCK_DIR/owner.$$" "$LOCK_DIR/owner" 2>/dev/null; then
        LOCK_DIR=""
        fail "lost the lock to another deploy while taking it"
    fi
}

release_lock_break() {
    if [ -n "$LOCK_BREAK" ]; then
        rmdir "$LOCK_BREAK" 2>/dev/null || true
        LOCK_BREAK=""
    fi
}

on_exit() {
    local status=$?

    # Cleanup runs to the end: no second signal, and no stop on a failed write to a closed terminal.
    trap '' INT TERM HUP
    set +e
    menu_cleanup
    limit_stop
    end_wait_line

    # The failed step of deploy.conf, if loaded: in the new release while it is on disk, else live.
    if [ "$status" -ne 0 ] && [ "$ACTION" = deploy ] && declare -F failed > /dev/null; then
        if [ -z "$NEW_RELEASE" ] || [ ! -d "$DEPLOY_BASE/releases/$NEW_RELEASE" ]; then
            RELEASE_NAME="$(current_release)"
            RELEASE_DIR="$DEPLOY_BASE/releases/$RELEASE_NAME"
        fi

        if [ -n "$RELEASE_NAME" ] && [ -d "$RELEASE_DIR" ]; then
            run_step failed
            set +e
            [ "$RUN_STATUS" -eq 0 ] || warn "$RUN_ERROR; the deploy failed anyway"
        fi
    fi

    # Never deletes the release that `current` points at, whatever the flags say.
    if [ -n "$NEW_RELEASE" ] && [ "$SWITCHED" -eq 0 ] && [ "$(current_release)" != "$NEW_RELEASE" ]; then
        rm -rf "${DEPLOY_BASE:?}/releases/$NEW_RELEASE"

        if [ "$status" -ne 0 ]; then
            warn "failed before the switch; ${PREVIOUS_RELEASE:-the old release} is still live"
        fi
    fi

    [ -z "$COPY_TMP" ] || rm -rf "$COPY_TMP"
    [ -z "$OPCACHE_FILE" ] || rm -f "$OPCACHE_FILE"

    if [ "$status" -ne 0 ] && [ -n "$ACTION" ]; then
        log_event "$ACTION" "$LOG_RELEASE" "failed: $STAGE"
    fi

    release_lock_break

    if [ -n "$LOCK_DIR" ]; then
        rm -rf "$LOCK_DIR"
    fi

    outro "$status"
}

# One line per deploy or rollback in <base>/deploy.log: UTC time, action, release, result, seconds.
# The alert goes first, and a log that cannot be written (disk full, read-only) only warns.
log_event() {
    local file="$DEPLOY_BASE/deploy.log" seconds status line
    seconds="$(($(date +%s) - STARTED))"
    line="$(printf '%s\t%s\t%s\t%s\t%s\t%s' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1${DEPLOY_SLOT:+@$DEPLOY_SLOT}" "${2:--}" "$3" \
        "$seconds" "$(shipped_summary)")"

    case "$1:$3" in
        rollback:ok*) status="rolled back" ;;
        *:ok*) status=ok ;;
        *"switched back"*) status="rolled back" ;;
        *) status=failed ;;
    esac

    # Failures and rollbacks always; a plain successful deploy only with NOTIFY_ON=all.
    if [ "$3" != ok ]; then
        notify "$1" "$1 ${2:--}: $3${FAIL_MESSAGE:+ ($FAIL_MESSAGE)}$(shipped_list)" "$status" "$2"
    elif [ "$NOTIFY_ON" = all ]; then
        notify "$1" "$1 $2: ok (${seconds}s)$(shipped_list)" "$status" "$2"
    fi

    if ! printf '%s\n' "$line" 2>/dev/null >> "$file"; then
        if [ "$LOG_WARNED" -eq 0 ]; then
            warn "could not write to $file"
            LOG_WARNED=1
        fi

        return 0
    fi

    # Keeps it small: past 1000 lines, only the last 500 stay.
    if [ "$(wc -l 2>/dev/null < "$file" || echo 0)" -gt 1000 ]; then
        if ! { tail -n 500 "$file" > "$file.tmp" && mv "$file.tmp" "$file"; } 2>/dev/null; then
            rm -f "$file.tmp" 2>/dev/null || true
        fi
    fi
}

# The last lines of deploy.log, with times in DISPLAY_TZ.
# Sends an alert: $1 is the event (deploy, rollback, check), $2 the text, $3 the status (ok,
# failed, rolled back, problem) and $4 the release. NOTIFY_URL gets JSON with a "text" field, which
# Slack-style webhooks show, and the deploy details. NOTIFY_CMD runs with them in NOTIFY_* and
# DEPLOY_* variables. Never fails: an alert that cannot be sent only warns.
notify() {
    local text body duration
    text="$(redact "${PROJECT:+$PROJECT: }$2")"
    duration="$(($(date +%s) - STARTED))"

    if [ -n "$NOTIFY_URL" ]; then
        # shellcheck disable=SC2016 # PHP code, not shell.
        body="$("$PHP_BIN" -r '
            $commits = [];
            foreach (array_slice(array_filter(explode("\n", $argv[9]), "strlen"), 0, 20) as $line) {
                $parts = explode(" ", $line, 2);
                $commits[] = ["sha" => $parts[0], "subject" => $parts[1] ?? ""];
            }
            echo json_encode(["text" => $argv[1], "project" => $argv[2], "event" => $argv[3],
                "status" => $argv[4], "release" => $argv[5], "previous" => $argv[6], "sha" => $argv[7],
                "ref" => $argv[8], "duration" => (int) $argv[10], "commits" => $commits],
                JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);' \
            "$text" "$PROJECT" "$1" "$3" "$(redact "$4")" "$(redact "$DEPLOY_PREVIOUS_RELEASE")" "$DEPLOY_SHA" \
            "$(redact "$DEPLOY_REF")" "$(redact "$SHIPPED")" "$duration" 2>/dev/null)" || body=""

        if [ -z "$body" ] || ! curl --silent --fail --max-time 10 --output /dev/null \
            --header 'Content-Type: application/json' --data "$body" "$NOTIFY_URL"; then
            warn "could not send the alert to NOTIFY_URL"
        fi
    fi

    if [ -n "$NOTIFY_CMD" ]; then
        if ! run_limited "$(short_limit 30)" env NOTIFY_EVENT="$1" NOTIFY_TEXT="$text" NOTIFY_PROJECT="$PROJECT" \
            NOTIFY_STATUS="$3" NOTIFY_RELEASE="$4" NOTIFY_DURATION="$duration" sh -c "$NOTIFY_CMD" > /dev/null 2>&1; then
            if [ "$TIMED_OUT" -eq 1 ]; then
                warn "NOTIFY_CMD ran past $(short_limit 30) s"
            else
                warn "NOTIFY_CMD failed"
            fi
        fi
    fi
}

# Sets DEPLOY_SHA, DEPLOY_AUTHOR and DEPLOY_MESSAGE from the commit checked out in folder $1.
commit_details() {
    DEPLOY_SHA="$(git -C "$1" rev-parse HEAD 2>/dev/null || true)"
    DEPLOY_AUTHOR="$(git -C "$1" log -1 --format=%an 2>/dev/null || true)"
    DEPLOY_MESSAGE="$(git -C "$1" log -1 --format=%s 2>/dev/null || true)"
}

# Finds the commits from the live commit ($1) to the new release ($2). A shallow release has no
# history, so those come from a commits-only clone. Sets SHIPPED; never fails the deploy.
shipped_commits() {
    local live_sha="$1" dir="$2" new_sha git_dir tmp=""
    SHIPPED=""

    [ -n "$live_sha" ] || return 0
    new_sha="$(git -C "$dir" rev-parse HEAD)"
    [ "$new_sha" != "$live_sha" ] || return 0
    git_dir="$dir"

    if [ "$(git -C "$dir" rev-parse --is-shallow-repository 2>/dev/null)" = true ]; then
        tmp="$(mktemp -d)"
        git_dir="$tmp/repo"
        history_clone "$REPO_URL" "$git_dir" || git_dir=""
    fi

    # Only when going forward: a --ref to an older commit ships nothing new.
    if [ -n "$git_dir" ] && git -C "$git_dir" merge-base --is-ancestor "$live_sha" "$new_sha" 2>/dev/null; then
        SHIPPED="$(git -C "$git_dir" log --format='%H %s' "$live_sha..$new_sha" 2>/dev/null | tr '\t' ' ' || true)"
    fi

    [ -z "$tmp" ] || rm -rf "$tmp"
}

# For deploy.log: "3 commits: Fix a; Add b; Update c", the first 5 subjects only.
shipped_summary() {
    local count

    [ -n "$SHIPPED" ] || return 0
    count="$(printf '%s\n' "$SHIPPED" | wc -l | tr -d ' ')"
    printf '%s commit(s): %s' "$count" \
        "$(printf '%s\n' "$SHIPPED" | sed -n '1,5p' | cut -d' ' -f2- | paste -sd ';' - | sed 's/;/; /g')"
    [ "$count" -le 5 ] || printf '; ...'
}

# For alerts and the deploy output: the first 10 commits, one per line.
shipped_list() {
    local count

    [ -n "$SHIPPED" ] || return 0
    count="$(printf '%s\n' "$SHIPPED" | wc -l | tr -d ' ')"
    printf '\n%s commit(s):\n' "$count"
    printf '%s\n' "$SHIPPED" | sed -nE '1,10s/^([0-9a-f]{7})[0-9a-f]* /  \1 /p'
    [ "$count" -le 10 ] || printf '  ... and %s more\n' "$((count - 10))"
}

show_log() {
    local count="${1:-20}" file="$DEPLOY_BASE/deploy.log"

    [[ "$count" =~ ^[0-9]+$ ]] || fail "usage: deploy [project] log [count]"

    if [ ! -f "$file" ]; then
        printf 'No deploys logged yet in %s\n' "$file"

        return
    fi

    # shellcheck disable=SC2016 # PHP code, not shell.
    tail -n "$count" "$file" | "$PHP_BIN" -r '
        $tz = new DateTimeZone($argv[1] !== "" ? $argv[1] : "UTC");
        while (($line = fgets(STDIN)) !== false) {
            [$time, $action, $release, $result, $seconds, $commits] = explode("\t", rtrim($line, "\n")) + array_fill(0, 6, "");
            $date = (new DateTime($time))->setTimezone($tz)->format("Y-m-d H:i T");
            if (strlen($commits) > 80) {
                $commits = (function_exists("mb_strcut") ? mb_strcut($commits, 0, 77) : substr($commits, 0, 77)) . "...";
            }
            printf("%s  %-8s  %s  %s (%ss)%s\n", $date, $action, $release, $result, $seconds, $commits !== "" ? "  $commits" : "");
        }
    ' "$DISPLAY_TZ"
}

current_release() {
    if [ -L "$DEPLOY_BASE/current" ]; then
        basename "$(readlink "$DEPLOY_BASE/current")"
    fi
}

# Prints the full path of the live release, or of DEPLOY_BASE with --base, and nothing else, so
# `cd "$(deploy path <project>)"` works. Creates nothing and takes no lock.
show_path() {
    local base

    case "${1:-}" in
        "" | --base) ;;
        *) fail "unknown project or option: $1 (usage: deploy path [project] [--base])" ;;
    esac

    [ -n "$DEPLOY_BASE" ] || fail "set DEPLOY_BASE in $PROJECTS_DIR/<project>.env"
    [ -d "$DEPLOY_BASE" ] || fail "${PROJECT:-the project} has no base folder ($DEPLOY_BASE)"
    base="$(cd "$DEPLOY_BASE" && pwd -P)"

    if [ "${1:-}" = --base ]; then
        printf '%s\n' "$base"

        return
    fi

    [ -d "$base/current" ] || fail "${PROJECT:-the project} has no live release ($base/current is missing)"
    (cd "$base/current" && pwd -P)
}

# Oldest first. Sorts on the timestamp digits alone, so older names without the dash
# (20261105171708-<sha>) mix with newer ones (20261105-171708-<tag>-<sha>).
# Skips unfinished builds: .building-* folders and releases that still hold BUILDING_FILE.
list_releases() {
    local name

    if [ -d "$DEPLOY_BASE/releases" ]; then
        find "$DEPLOY_BASE/releases" -mindepth 1 -maxdepth 1 -type d -name '[0-9]*' -exec basename {} \; \
            | while IFS= read -r name; do
                [ -e "$DEPLOY_BASE/releases/$name/$BUILDING_FILE" ] || printf '%s\n' "$name"
            done \
            | awk '{ key = $0; sub(/^[0-9]{8}-/, substr($0, 1, 8), key); print substr(key, 1, 14) "\t" $0 }' \
            | sort | cut -f2
    fi
}

# A deploy builds a release under its final name with this file in it, and removes the file
# right before the switch. Laravel caches (config:cache, view:cache) keep absolute paths, so the
# folder is never renamed after the build. A build killed hard (SIGKILL, OOM) keeps the file.
BUILDING_FILE=".building"

# Removes builds that a killed deploy left: .building-<stamp> clones and releases that still
# hold BUILDING_FILE. Only under the lock, so no running deploy owns them.
remove_unfinished() {
    local dir live
    live="$(current_release)"

    for dir in "$DEPLOY_BASE"/releases/.building-* "$DEPLOY_BASE"/releases/*/"$BUILDING_FILE"; do
        [ -e "$dir" ] || continue
        [ "${dir##*/}" != "$BUILDING_FILE" ] || dir="${dir%/*}"
        [ "${dir##*/}" != "$live" ] || continue
        say "Removing unfinished build ${dir##*/}"
        rm -rf "$dir"
    done
}

# A plain rollback leaves this file in the release it leaves, so the next one skips it.
is_bad() {
    [ -e "$DEPLOY_BASE/releases/$1/.bad" ]
}

# The newest release older than the given one that is not marked bad, or nothing.
rollback_target() {
    local release target=""

    for release in $(list_releases); do
        [ "$release" != "$1" ] || break
        is_bad "$release" || target="$release"
    done

    printf '%s\n' "$target"
}

# The one release whose name is or contains $1 (a full name, a sha, a tag). A whole part of a
# name wins, so v2026.11.1 does not also match v2026.11.10.
find_release() {
    local matches count name exact=""
    matches="$(list_releases | grep -F -- "$1" || true)"

    while IFS= read -r name; do
        case "-$name-" in
            *"-$1-"*) exact="$exact$name"$'\n' ;;
        esac
    done <<< "$matches"

    [ -z "$exact" ] || matches="${exact%$'\n'}"
    count="$(printf '%s' "$matches" | grep -c . || true)"

    [ "$count" -gt 0 ] || fail "no release matches '$1' (see: deploy status)"
    [ "$count" -eq 1 ] || fail "'$1' matches $count releases; use more of the name"

    printf '%s\n' "$matches"
}

# The deploy time in a release name, in DISPLAY_TZ, or in UTC when unset: "today at 13:30 EST",
# "yesterday at 13:30 EST", or "2026-11-05 13:30 EST" for older ones.
release_time() {
    local stamp="${1//-/}"

    # shellcheck disable=SC2016 # PHP code, not shell.
    "$PHP_BIN" -r '
        $tz = new DateTimeZone($argv[2] !== "" ? $argv[2] : "UTC");
        $d = DateTime::createFromFormat("YmdHis", $argv[1], new DateTimeZone("UTC"))->setTimezone($tz);
        $day = $d->format("Y-m-d");
        $today = new DateTime("now", $tz);

        if ($day === $today->format("Y-m-d")) {
            $day = "today at";
        } elseif ($day === $today->modify("-1 day")->format("Y-m-d")) {
            $day = "yesterday at";
        }

        echo $day, " ", $d->format("H:i T");
    ' "${stamp:0:14}" "$DISPLAY_TZ" 2>/dev/null || printf 'unknown time'
}

# Reads the remote's release tags and the no-release marker of commit $1 in one call. Sets TAG to
# the highest release tag on the commit (v2026.11.21), HAS_TAGS to 1 when the repo has any `v*` tag, and
# NO_RELEASE to 1 when the release workflow marked the commit with refs/no-release/<sha>.
release_refs() {
    local refs
    refs="$(git ls-remote "$REPO_URL" 'refs/tags/v*' "refs/no-release/$1" 2>/dev/null || true)"

    TAG="$(printf '%s\n' "$refs" \
        | awk -v sha="$1" '$1 == sha { sub(/^refs\/tags\//, "", $2); sub(/\^\{\}$/, "", $2); print $2 }' \
        | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -t. -k1.2,1n -k2,2n -k3,3n | tail -n1 || true)"
    HAS_TAGS=0
    NO_RELEASE=0

    # No grep -q in a pipe: with pipefail, an early exit can fail the pipeline.
    case "$refs" in
        *$'\trefs/tags/v'*) HAS_TAGS=1 ;;
    esac

    case $'\n'"$refs"$'\n' in
        *$'\trefs/no-release/'"$1"$'\n'*) NO_RELEASE=1 ;;
    esac
}

# Shows the wait line. On a terminal it is rewritten in place; elsewhere each check gets a line.
wait_line() {
    if [ -t 1 ]; then
        printf '\r\033[K%s' "$(say "$1")"
        WAIT_LINE=1
    else
        say "$1"
    fi
}

# Ends the wait line on a terminal, so the next output starts on a new line.
end_wait_line() {
    if [ "$WAIT_LINE" -eq 1 ]; then
        printf '\n'
        WAIT_LINE=0
    fi
}

# Prints the version of release $1 (<date>-<time>[-<tag>]-<sha>): its tag, else its short sha.
release_version() {
    local rest="${1#*-*-}"

    case "$rest" in
        *-*) printf '%s\n' "${rest%-*}" ;;
        *) printf '%s\n' "$rest" ;;
    esac
}

# Sets TAG to the release tag on the cloned commit in $1. A commit under 5 minutes old in a repo
# with release tags may not have its tag yet: waits up to RELEASE_WAIT seconds for it, unless $2 is 1.
# A commit with a no-release marker never gets a tag, so the wait stops at once.
wait_release_tag() {
    local dir="$1" no_wait="$2" sha short age started elapsed=0 nap
    # Not a setting: lets the tests poll faster.
    local poll="${RELEASE_POLL:-5}"

    sha="$(git -C "$dir" rev-parse HEAD)"
    short="$(git -C "$dir" rev-parse --short HEAD)"
    release_refs "$sha"

    # A repo without release tags never gets one.
    if [ -n "$TAG" ] || [ "$HAS_TAGS" -eq 0 ]; then
        return
    fi

    if [ "$NO_RELEASE" -eq 1 ]; then
        say "no-release merge; deploying without a tag"

        return
    fi

    age=$(($(date +%s) - $(git -C "$dir" log -1 --format=%ct HEAD)))

    if [ "$no_wait" -eq 0 ] && [ "$RELEASE_WAIT" -gt 0 ] && [ "$age" -lt 300 ]; then
        started="$(date +%s)"
        wait_line "Waiting for the release tag on $short (0 s of $RELEASE_WAIT)"

        while [ -z "$TAG" ] && [ "$NO_RELEASE" -eq 0 ] && [ "$elapsed" -lt "$RELEASE_WAIT" ]; do
            nap=$((RELEASE_WAIT - elapsed))
            [ "$nap" -le "$poll" ] || nap="$poll"
            # In the background, so a signal stops the wait at once and on_exit frees the lock.
            sleep "$nap" &
            wait $!
            release_refs "$sha"
            elapsed=$(($(date +%s) - started))
            [ "$elapsed" -le "$RELEASE_WAIT" ] || elapsed="$RELEASE_WAIT"
            wait_line "Waiting for the release tag on $short ($elapsed s of $RELEASE_WAIT)"
        done

        end_wait_line

        if [ -n "$TAG" ]; then
            return
        elif [ "$NO_RELEASE" -eq 1 ]; then
            say "no-release merge; deploying without a tag"
        else
            warn "no release tag on $short after $RELEASE_WAIT s; deploying without one"
        fi

        return
    fi

    warn "no release tag on $short; deploying without one"
}

# Commits on DEPLOY_BRANCH (or the pull request head) after the live one. Sets PENDING_COUNT (empty when unknown),
# PENDING_LOG (newest first), PENDING_NOTE (why the count is unknown) and PENDING_TIP (the branch tip).
pending_commits() {
    local repo live_sha tip tmp
    PENDING_COUNT=""
    PENDING_LOG=""
    PENDING_NOTE=""
    PENDING_TIP=""

    repo="${REPO_URL:-$(git -C "$DEPLOY_BASE/current" remote get-url origin 2>/dev/null || true)}"
    live_sha="$(git -C "$DEPLOY_BASE/releases/$1" rev-parse HEAD 2>/dev/null || true)"

    if [ -z "$repo" ] || [ -z "$live_sha" ]; then
        PENDING_NOTE="no repo to compare with"

        return
    fi

    tip="$(git ls-remote "$repo" "$(branch_ref)" 2>/dev/null | cut -f1)" || true

    if [ -z "$tip" ]; then
        PENDING_NOTE="cannot read $(branch_label) from the repo"

        return
    fi

    PENDING_TIP="$tip"

    if [ "$tip" = "$live_sha" ]; then
        PENDING_COUNT=0

        return
    fi

    # Commits only, no files, so even a long history is quick to fetch.
    tmp="$(mktemp -d)"

    if ! history_clone "$repo" "$tmp/repo"; then
        PENDING_NOTE="cannot clone the repo"
    elif ! git -C "$tmp/repo" merge-base --is-ancestor "$live_sha" HEAD 2>/dev/null; then
        PENDING_NOTE="the live commit is not on $(branch_label)"
    else
        PENDING_COUNT="$(git -C "$tmp/repo" rev-list --count "$live_sha..HEAD")"
        PENDING_LOG="$(git -C "$tmp/repo" log --format='%h %s' "$live_sha..HEAD")"
    fi

    rm -rf "$tmp"
}

# Swaps the `current` link in one rename, so no request sees a missing or half-made link.
switch_to() {
    local link="$DEPLOY_BASE/current"
    local tmp="$DEPLOY_BASE/current.tmp"

    ln -sfn "releases/$1" "$tmp"

    # GNU mv -T renames over the link itself. BSD mv (macOS) spells it -h.
    if mv -Tf "$tmp" "$link" 2>/dev/null || mv -hf "$tmp" "$link" 2>/dev/null; then
        :
    else
        # Not atomic: there is a moment with no link at all.
        rm -f "$tmp"
        ln -sfn "releases/$1" "$link"
    fi

    # Set here, before the reload, so a signal from now on never deletes the live release.
    SWITCHED=1

    if [ -n "$PHP_RELOAD_CMD" ] && ! run_limited "$(short_limit 60)" sh -c "$PHP_RELOAD_CMD"; then
        if [ "$TIMED_OUT" -eq 1 ]; then
            warn "PHP_RELOAD_CMD ran past $(short_limit 60) s; carrying on"
        else
            say "PHP_RELOAD_CMD failed; carrying on"
        fi
    fi

    reset_opcache_web
}

# Resets the OPcache of the web server's PHP, which a shell command cannot reach: writes a PHP file
# with a random name into OPCACHE_RESET_DIR, calls it once at the host of CHECK_URL, and deletes it.
# A failure only warns.
reset_opcache_web() {
    local dir name url reply status code limit

    [ -n "$OPCACHE_RESET_DIR" ] || return 0
    dir="$DEPLOY_BASE/current/${OPCACHE_RESET_DIR%/}"

    if [ ! -d "$dir" ]; then
        warn "the release has no $OPCACHE_RESET_DIR folder; OPcache not reset, carrying on"
        return 0
    fi
    if [ -z "$CHECK_URL" ]; then
        warn "no CHECK_URL to call the OPcache reset at; carrying on"
        return 0
    fi

    name="rs-opcache-$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n').php"
    OPCACHE_FILE="$dir/$name"

    # The file deletes itself too, in case the engine cannot.
    if ! cat > "$OPCACHE_FILE" 2>/dev/null <<'PHP'
<?php
@unlink(__FILE__);
header('Cache-Control: no-store');
echo function_exists('opcache_reset') && @opcache_reset() ? 'rs-opcache-reset' : 'rs-opcache-off';
PHP
    then
        rm -f "$OPCACHE_FILE"
        OPCACHE_FILE=""
        warn "cannot write to $dir; OPcache not reset, carrying on"
        return 0
    fi

    # Scheme, user, host and port of CHECK_URL.
    url="$(printf '%s' "$CHECK_URL" | sed -E 's#^([^:/]+://[^/?#]*).*#\1#')/$name"
    limit="$(short_limit 60)"
    reply="$(curl --silent --max-time "$limit" --header 'Cache-Control: no-cache' \
        --write-out '\n%{http_code}' "$url" 2>/dev/null)" && status=0 || status=$?

    rm -f "$OPCACHE_FILE"
    OPCACHE_FILE=""
    code="${reply##*$'\n'}"

    if [ "$status" -eq 28 ]; then
        warn "OPcache reset at $url ran past $limit s; carrying on"
    elif [ "$code" != 200 ]; then
        warn "OPcache reset at $url answered ${code:-nothing}; carrying on"
    else
        case "$reply" in
            *rs-opcache-reset*) say "Reset OPcache" ;;
            *rs-opcache-off*) say "No OPcache in the web server's PHP; nothing to reset" ;;
            *) warn "OPcache reset at $url answered 200 without running; carrying on" ;;
        esac
    fi
}

require_check_url() {
    [ -n "$CHECK_URL" ] || fail "set CHECK_URL in $PROJECTS_DIR/<project>.env"
}

# Prints the engine names deploy.conf $1 takes: the functions it defines and the engine variables
# it changes. Loads it in a subshell, so nothing reaches the engine.
conf_clashes() (
    set +eu
    conf_list=" "
    conf_values=()
    conf_value=""

    for conf_name in "${SETTINGS[@]}"; do
        conf_list="$conf_list$conf_name "
    done
    for conf_name in $(compgen -v); do
        case "$START_VARS$conf_list" in *" $conf_name "*) continue ;; esac
        case "$conf_name" in conf_* | SHARED | COPY_FROM_LIVE | BASH_REMATCH | PIPESTATUS) continue ;; esac
        conf_list="$conf_list$conf_name "
    done

    for conf_name in $conf_list; do
        eval "conf_values+=(\"\${#${conf_name}[@]}:\${${conf_name}[*]}\")"
    done

    # shellcheck disable=SC2086 # One name per word.
    unset -f $ENGINE_FUNCS
    conf_ifs="$IFS"
    # shellcheck source=/dev/null
    . "$1" > /dev/null 2>&1
    IFS="$conf_ifs"

    for conf_name in $ENGINE_FUNCS; do
        ! declare -F "$conf_name" > /dev/null || printf '%s() ' "$conf_name"
    done

    conf_i=0
    for conf_name in $conf_list; do
        eval "conf_value=\"\${#${conf_name}[@]}:\${${conf_name}[*]}\""
        [ "$conf_value" = "${conf_values[$conf_i]}" ] || printf '%s ' "$conf_name"
        conf_i=$((conf_i + 1))
    done
)

# Reads deploy.conf of a release: SHARED and the step functions.
load_conf() {
    local clashes
    [ -f "$1/deploy.conf" ] || fail "$DEPLOY_BRANCH has no deploy.conf"

    clashes="$(conf_clashes "$1/deploy.conf")"
    [ -z "$clashes" ] \
        || fail "deploy.conf uses names of the engine: ${clashes% }; rename them (see README, deploy.conf)"

    SHARED=()
    COPY_FROM_LIVE=()
    unset -f preflight backup build verify after_switch failed after_rollback

    # shellcheck source=/dev/null
    . "$1/deploy.conf"

    declare -F build > /dev/null || fail "deploy.conf has no build step"
}

# Runs "$@" with a time limit of $1 seconds (0: none), in a process group of its own, so a
# timeout stops everything the command started. Returns its exit code; sets TIMED_OUT to 1 when
# the limit stopped it. Its stdin is /dev/null: a background group must never read the terminal.
run_limited() {
    local limit="$1" started status
    shift
    TIMED_OUT=0
    started="$(date +%s)"

    # A pipeline subshell, as in `report`, does not get the EXIT trap that stops the group. Signals
    # ignored, as in on_exit, stay ignored.
    if [ "$BASH_SUBSHELL" -gt 0 ] && [ "$(trap -p INT)" != "trap -- '' SIGINT" ]; then
        trap 'limit_stop; exit 130' INT
        trap 'limit_stop; exit 143' TERM
        trap 'limit_stop; exit 129' HUP
    fi

    # Job control gives each background job its own process group. Its job notices ("Terminated")
    # go to stderr, so that is hidden until the jobs are reaped; the command keeps the real one.
    exec 4>&2 2>/dev/null
    LIMIT_FD=1
    set -m
    "$@" < /dev/null 2>&4 4>&- &
    LIMIT_PID=$!

    if [ "$limit" -gt 0 ]; then
        (
            sleep "$limit"
            kill -TERM -- "-$LIMIT_PID" 2>/dev/null || exit 0

            # A few seconds to exit cleanly, then forced.
            for _ in 1 2 3; do
                sleep 1
                kill -0 -- "-$LIMIT_PID" 2>/dev/null || exit 0
            done
            kill -KILL -- "-$LIMIT_PID" 2>/dev/null
        ) < /dev/null > /dev/null 2>&1 4>&- &
        LIMIT_DOG=$!
    fi
    set +m

    wait "$LIMIT_PID" && status=0 || status=$?

    if [ "$limit" -gt 0 ] && [ "$status" -ne 0 ] && [ $(($(date +%s) - started)) -ge "$limit" ]; then
        TIMED_OUT=1
        # Lets the watchdog finish stopping the rest of the group.
        wait "$LIMIT_DOG" || true
        LIMIT_DOG=""
    fi

    # On success the group stays: a step may start a worker that should outlive it.
    LIMIT_PID=""
    limit_stop

    return "$status"
}

# Stops what run_limited is running: the watchdog, and the command's whole process group. Gives
# back the real stderr.
limit_stop() {
    if [ -n "$LIMIT_DOG" ]; then
        kill -KILL -- "-$LIMIT_DOG" 2>/dev/null || true
        wait "$LIMIT_DOG" 2>/dev/null || true
        LIMIT_DOG=""
    fi

    if [ -n "$LIMIT_PID" ]; then
        kill -KILL -- "-$LIMIT_PID" 2>/dev/null || true
        wait "$LIMIT_PID" 2>/dev/null || true
        LIMIT_PID=""
    fi

    if [ "$LIMIT_FD" -eq 1 ]; then
        exec 2>&4 4>&-
        LIMIT_FD=0
    fi
}

# The time limit for PHP_RELOAD_CMD and NOTIFY_CMD: $1 seconds, or STEP_TIMEOUT when smaller.
short_limit() {
    if [ "$STEP_TIMEOUT" -gt 0 ] && [ "$STEP_TIMEOUT" -lt "$1" ]; then
        printf '%s' "$STEP_TIMEOUT"
    else
        printf '%s' "$1"
    fi
}

# Runs one step of deploy.conf in the release folder, if the project has it. Sets RUN_STATUS, and
# RUN_ERROR to the message for a failed step.
run_step() {
    local status

    RUN_STATUS=0
    RUN_ERROR=""
    declare -F "$1" > /dev/null || return 0
    say "Running $1"

    # Off here, so `set -e` inside the subshell stops the step at its first failing command.
    set +e
    run_limited "$STEP_TIMEOUT" step_body "$1"
    status=$?
    set -e

    # A plain return would trip `set -e` in the caller; it reads RUN_STATUS instead.
    RUN_STATUS="$status"

    if [ "$TIMED_OUT" -eq 1 ]; then
        RUN_ERROR="$1 ran past STEP_TIMEOUT ($STEP_TIMEOUT s)"
    elif [ "$status" -ne 0 ]; then
        RUN_ERROR="$1 failed"
    fi
}

# The body of run_step, in its own process group. On the rails, the step's exit code comes back
# through the pipe to rail.
step_body() {
    if [ "$RAILS" -eq 1 ]; then
        (
            set -e
            cd "$RELEASE_DIR"
            "$1"
        ) 2>&1 | rail
        return "${PIPESTATUS[0]}"
    fi

    (
        set -e
        cd "$RELEASE_DIR"
        "$1"
    )
}

# Fails unless SHARED path $1 stays inside the release folder.
check_shared_path() {
    case "/$1/" in
        //* | */../*) fail "SHARED path '$1' must stay inside the release: no leading / and no .." ;;
    esac
}

link_shared() {
    local path

    for path in ${SHARED[@]+"${SHARED[@]}"}; do
        check_shared_path "$path"
        [ -e "$DEPLOY_BASE/shared/$path" ] || fail "shared/$path is missing (run init, or create it)"

        rm -rf "${RELEASE_DIR:?}/$path"
        mkdir -p "$(dirname "$RELEASE_DIR/$path")"
        ln -sfn "$DEPLOY_BASE/shared/$path" "$RELEASE_DIR/$path"
    done
}

# Copies COPY_FROM_LIVE paths (e.g. vendor) from the live release, so the build only updates them.
# A copy, not a link: the build must never change files the live site runs on.
copy_from_live() {
    local path from

    [ -n "$PREVIOUS_RELEASE" ] || return 0

    for path in ${COPY_FROM_LIVE[@]+"${COPY_FROM_LIVE[@]}"}; do
        from="$DEPLOY_BASE/releases/$PREVIOUS_RELEASE/$path"

        # Skips paths the repo tracks, and ones the live release does not have.
        if [ -e "$RELEASE_DIR/$path" ] || [ ! -e "$from" ]; then
            continue
        fi

        say "Copying $path from $PREVIOUS_RELEASE"
        mkdir -p "$(dirname "$RELEASE_DIR/$path")"
        cp -a "$from" "$RELEASE_DIR/$path"
    done
}

# One request to CHECK_URL. Sets PROBE_STATUS and PROBE_VERSION (empty when missing).
# Adds rs=<release or time> and no-cache headers, so LSCache or a CDN does not answer
# with an old page. Pass the release being checked, if any.
# Each request gets CHECK_WAIT / 3 seconds (1 to 10), so one stuck request leaves time to retry.
probe() {
    local tag url headers limit
    limit=$((CHECK_WAIT / 3))
    [ "$limit" -ge 1 ] || limit=1
    [ "$limit" -le 10 ] || limit=10
    tag="${1:-}"
    tag="${tag:+$tag-}$(date +%s)"
    tag="${tag//[^[:alnum:].-]/-}"
    url="${CHECK_URL%%#*}"

    case "$url" in
        *\? | *\&) url="${url}rs=$tag" ;;
        *\?*) url="$url&rs=$tag" ;;
        *) url="$url?rs=$tag" ;;
    esac

    headers="$(curl --silent --show-error --max-time "$limit" --location --output /dev/null --dump-header - \
        --header 'Cache-Control: no-cache' --header 'Pragma: no-cache' "$url" 2>&1)" || true
    PROBE_STATUS="$(printf '%s\n' "$headers" | sed -nE 's#^HTTP/[0-9.]+ ([0-9]+).*#\1#p' | tail -n1)"
    # Only the last answer counts: a redirect hop may send a version of its own.
    PROBE_VERSION="$(printf '%s\n' "$headers" | awk '
        /^HTTP\// { version = "" }
        /^[Xx]-[Aa]pp-[Vv]ersion:/ { version = $0; sub(/^[^:]*: */, "", version); sub(/[[:space:]].*$/, "", version) }
        END { print version }')"
}

# Polls CHECK_URL until it answers 200 (with the new version, unless CHECK_VERSION=0),
# or CHECK_WAIT runs out.
release_is_serving() {
    local expected="$1" deadline
    deadline=$(($(date +%s) + CHECK_WAIT))

    while :; do
        probe "$expected"

        if [ "$PROBE_STATUS" = 200 ] && { [ "$CHECK_VERSION" = 0 ] || [ "$PROBE_VERSION" = "$expected" ]; }; then
            return 0
        fi

        if [ "$(date +%s)" -ge "$deadline" ]; then
            warn "$CHECK_URL answered ${PROBE_STATUS:-nothing (no answer)} with version ${PROBE_VERSION:-none}"

            return 1
        fi

        sleep 2
    done
}

prune() {
    local live release count
    live="$(current_release)"
    count="$(list_releases | wc -l)"

    rm -rf "${DEPLOY_BASE:?}"/releases/.failed-*

    # BSD head rejects -n 0.
    if [ "$count" -le "$KEEP_RELEASES" ]; then
        return
    fi

    # Requests and the PHP realpath cache may still run in the release that was live before
    # this deploy, so it goes on the next one.
    for release in $(list_releases | head -n "$((count - KEEP_RELEASES))"); do
        if [ "$release" != "$live" ] && [ "$release" != "$PREVIOUS_RELEASE" ]; then
            say "Removing old release $release"
            rm -rf "${DEPLOY_BASE:?}/releases/$release"
        fi
    done
}

# DISK_LIMIT in KB, rounded up; empty when there is no limit.
disk_limit_kb() {
    [ -n "$DISK_LIMIT" ] || return 0
    printf '%s\n' "$DISK_LIMIT" | awk '{
        n = $0 + 0; unit = toupper(substr($0, length($0)))
        if (unit == "K") n *= 1024; else if (unit == "M") n *= 1048576
        else if (unit == "G") n *= 1073741824; else if (unit == "T") n *= 1099511627776
        kb = n / 1024; printf "%.0f\n", (kb == int(kb)) ? kb : int(kb) + 1
    }'
}

# $1 KB as 512K, 1.5M or 2.0G.
human_kb() {
    awk -v kb="$1" 'BEGIN {
        if (kb >= 1073741824) printf "%.1fT", kb / 1073741824
        else if (kb >= 1048576) printf "%.1fG", kb / 1048576
        else if (kb >= 1024) printf "%.1fM", kb / 1024
        else printf "%dK", kb
    }'
}

# Free KB on the file system that holds the base folder; empty when df fails.
disk_free_kb() {
    df -Pk "$DEPLOY_BASE" 2>/dev/null | awk 'NR == 2 { print $4 }'
}

# Sets DISK_TEXT ("2.1G used of 3.0G, 10.4G free") and DISK_PROBLEM (empty when fine).
disk_usage() {
    local used free limit

    # du may complain about files it cannot read; the size it prints is still close.
    used="$(du -sk "$DEPLOY_BASE" 2>/dev/null | awk '{ print $1 }')" || true
    free="$(disk_free_kb)" || true
    limit="$(disk_limit_kb)"
    used="${used:-0}"
    DISK_TEXT="$(human_kb "$used") used"
    [ -z "$limit" ] || DISK_TEXT="$DISK_TEXT of $(human_kb "$limit")"

    if [ -n "$free" ]; then
        DISK_TEXT="$DISK_TEXT, $(human_kb "$free") free"
    else
        DISK_TEXT="$DISK_TEXT, free space unknown"
    fi

    DISK_PROBLEM=""

    if [ -n "$limit" ] && [ "$used" -gt "$limit" ]; then
        DISK_PROBLEM="over DISK_LIMIT ($DISK_LIMIT)"
    fi

    if [ -n "$free" ] && [ "$MIN_FREE_MB" -gt 0 ] && [ "$free" -lt $((MIN_FREE_MB * 1024)) ]; then
        DISK_PROBLEM="${DISK_PROBLEM:+$DISK_PROBLEM, }under MIN_FREE_MB (${MIN_FREE_MB}M free)"
    fi
}

# Fails when the file system has less than MIN_FREE_MB free, before $1 writes anything.
require_free_space() {
    local free

    [ "$MIN_FREE_MB" -gt 0 ] || return 0
    free="$(disk_free_kb)" || true
    [ -n "$free" ] || return 0
    [ "$free" -ge $((MIN_FREE_MB * 1024)) ] \
        || fail "only $(human_kb "$free") free on the disk of $DEPLOY_BASE, under MIN_FREE_MB (${MIN_FREE_MB}M); free some space before $1"
}

# Set by freeze: "<UTC stamp>" on the first line, the reason on the second.
FREEZE_FILE=".frozen"

# Set by down, the same way.
DOWN_FILE=".down"

# "since today at 11:00 EST: reason" from the file $1, or empty when it is not there.
marker_text() {
    local stamp reason

    [ -f "$DEPLOY_BASE/$1" ] || return 0
    { read -r stamp; read -r reason; } < "$DEPLOY_BASE/$1" || true
    printf 'since %s: %s' "$(release_time "${stamp:-0}")" "${reason:-no reason given}"
}

frozen_text() {
    marker_text "$FREEZE_FILE"
}

is_down() {
    [ -f "$DEPLOY_BASE/$DOWN_FILE" ]
}

# Runs step $1 (down or up) from the live release's deploy.conf, in that release.
run_live_step() {
    local live
    live="$(current_release)"
    [ -n "$live" ] || fail "$DEPLOY_BASE/current is not a link; no live release"

    RELEASE_DIR="$DEPLOY_BASE/releases/$live"
    RELEASE_NAME="$live"
    export RELEASE_DIR RELEASE_NAME
    commit_details "$RELEASE_DIR"
    load_conf "$RELEASE_DIR"
    declare -F "$1" > /dev/null || fail "deploy.conf of $live has no $1 step"

    ACTION="$1"
    LOG_RELEASE="$live"
    STAGE="$1"
    run_step "$1"
    [ "$RUN_STATUS" -eq 0 ] || fail "$RUN_ERROR"
}

# Not named down and up: deploy.conf defines those.
maintenance_down() {
    local arg words=()

    for arg in "$@"; do
        case "$arg" in
            --yes | -y) YES=1 ;;
            *) words+=("$arg") ;;
        esac
    done

    DOWN_REASON="${words[*]-}"
    export DOWN_REASON
    resolve_base
    confirm "Take the site down?" "Taking $PROJECT down: ${DOWN_REASON:-no reason given}" \
        "The site shows its maintenance page until: deploy ${PROJECT:+$PROJECT }up"

    acquire_lock down
    run_live_step down

    printf '%s\n%s\n' "$(date -u +%Y%m%d%H%M%S)" "$DOWN_REASON" > "$DEPLOY_BASE/$DOWN_FILE"
    log_event down "$LOG_RELEASE" ok
    ACTION=""
    say "The site is down for maintenance: ${DOWN_REASON:-no reason given}"
    say "Deploys skip the site check until: deploy ${PROJECT:+$PROJECT }up"
}

maintenance_up() {
    resolve_base
    acquire_lock up
    run_live_step up
    rm -f "$DEPLOY_BASE/$DOWN_FILE"

    if [ -n "$CHECK_URL" ]; then
        say "Checking $CHECK_URL"
        STAGE=check
        release_is_serving "$LOG_RELEASE" || fail "up ran, but the site does not serve $LOG_RELEASE"
    fi

    log_event up "$LOG_RELEASE" ok
    ACTION=""
    say "The site is up again"
}

refuse_if_frozen() {
    local text
    text="$(frozen_text)"
    [ -z "$text" ] || fail "deploys are frozen $text (run: deploy ${PROJECT:+$PROJECT }unfreeze)"
}

freeze() {
    resolve_base
    printf '%s\n%s\n' "$(date -u +%Y%m%d%H%M%S)" "${1:-}" > "$DEPLOY_BASE/$FREEZE_FILE"
    say "Deploys and rollbacks are frozen: ${1:-no reason given}"
}

unfreeze() {
    resolve_base

    if [ -f "$DEPLOY_BASE/$FREEZE_FILE" ]; then
        rm -f "$DEPLOY_BASE/$FREEZE_FILE"
        say "Deploys are allowed again"
    else
        say "Deploys were not frozen"
    fi
}

# Options: --ref <tag, branch or sha> deploys that instead of the newest commit of DEPLOY_BRANCH;
# --force builds even when that commit is already live; --no-wait does not wait for a release tag.
# On a staging slot, --branch <name> sets the branch the slot follows and deploys it; --pr <number>
# does the same for the head of that pull request. A free slot deploys DEPLOY_BRANCH and stays free.
# --ref and --pr never wait for a release tag.
deploy() {
    local force=0 ref="" no_wait=0 branch="" pr=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --force) force=1 ;;
            --no-wait) no_wait=1 ;;
            --yes | -y) YES=1 ;;
            --ref=*) ref="${1#--ref=}" ;;
            --ref)
                [ -n "${2:-}" ] || fail "usage: deploy [project] [--ref <tag, branch or sha>] [--force] [--no-wait] [--yes]"
                ref="$2"
                shift
                ;;
            --branch=*) branch="${1#--branch=}" ;;
            --branch)
                [ -n "${2:-}" ] || fail "usage: deploy <project>@sN --branch <name>"
                branch="$2"
                shift
                ;;
            --pr=*) pr="${1#--pr=}" ;;
            --pr)
                [ -n "${2:-}" ] || fail "usage: deploy <project>@sN --pr <number>"
                pr="$2"
                shift
                ;;
            *) fail "unknown option for deploy: $1" ;;
        esac

        shift
    done

    if [ -z "$DEPLOY_SLOT" ]; then
        [ -z "$branch" ] || fail "--branch is for staging slots (deploy ${PROJECT:-<project>}@s1 --branch $branch); production deploys DEPLOY_BRANCH ($DEPLOY_BRANCH), or use --ref"
        [ -z "$pr" ] || fail "--pr is for staging slots (deploy ${PROJECT:-<project>}@s1 --pr $pr); production deploys DEPLOY_BRANCH ($DEPLOY_BRANCH), or use --ref"
    elif [ -n "$branch" ]; then
        [ -z "$ref" ] || fail "use --branch or --ref, not both"
        [ -z "$pr" ] || fail "use --branch or --pr, not both"
        ! is_pr_branch "$branch" || fail "$branch is how a slot stores a pull request; use --pr ${branch#pr/}"
    elif [ -n "$pr" ]; then
        [ -z "$ref" ] || fail "use --pr or --ref, not both"
        [[ "$pr" =~ ^[1-9][0-9]*$ ]] || fail "--pr takes a pull request number, not '$pr'"
    fi

    resolve_base
    refuse_current_folder
    refuse_if_frozen
    require_check_url
    acquire_lock deploy
    ACTION=deploy
    STAGE=clone
    require_free_space deploying

    mkdir -p "$DEPLOY_BASE/releases"
    PREVIOUS_RELEASE="$(current_release)"
    DEPLOY_PREVIOUS_RELEASE="$PREVIOUS_RELEASE"
    DEPLOY_FORCED="$force"

    if [ -z "$REPO_URL" ]; then
        [ -n "$PREVIOUS_RELEASE" ] || fail "set REPO_URL for the first deploy"
        REPO_URL="$(git -C "$DEPLOY_BASE/current" remote get-url origin 2>/dev/null)" \
            || fail "set REPO_URL; $DEPLOY_BASE/current has no origin remote"
    fi

    if [ -n "$branch" ]; then
        # Exactly one ref, so a name with * cannot match many.
        [ "$branch" = "${branch#-}" ] \
            && [ "$(git ls-remote "$REPO_URL" "refs/heads/$branch" 2>/dev/null | cut -f2)" = "refs/heads/$branch" ] \
            || fail "no branch $branch in the repo"
        printf '%s\n' "$branch" > "$DEPLOY_BASE/BRANCH"
        DEPLOY_BRANCH="$branch"
        SLOT_BRANCH="$branch"
        SLOT_PR=""
        say "$PROJECT now follows $branch"
    fi

    if [ -n "$pr" ]; then
        [ "$(git ls-remote "$REPO_URL" "refs/pull/$pr/head" 2>/dev/null | cut -f2)" = "refs/pull/$pr/head" ] \
            || fail "no pull request #$pr in the repo (no refs/pull/$pr/head)"
        printf 'pr/%s\n' "$pr" > "$DEPLOY_BASE/BRANCH"
        DEPLOY_BRANCH="pr/$pr"
        SLOT_BRANCH="pr/$pr"
        SLOT_PR="$pr"
        say "$PROJECT now follows PR #$pr"
    fi

    DEPLOY_REF="${ref:-$DEPLOY_BRANCH}"

    local stamp sha live_sha="" tip err subject forced

    [ -z "$PREVIOUS_RELEASE" ] || live_sha="$(git -C "$DEPLOY_BASE/current" rev-parse HEAD 2>/dev/null || true)"

    # Like Deployer's check_remote: an empty release would only push a good one out.
    if [ -n "$PREVIOUS_RELEASE" ] && [ -z "$ref" ] && [ "$force" -eq 0 ]; then
        tip="$(git ls-remote "$REPO_URL" "$(branch_ref)" 2>/dev/null | cut -f1)" || true

        if [ -n "$live_sha" ] && [ "$tip" = "$live_sha" ]; then
            say "Nothing new on $(branch_label): $PREVIOUS_RELEASE already runs ${tip:0:7}"
            say "To build it again anyway: deploy ${PROJECT:+$PROJECT }--force"

            return
        fi
    fi

    stamp="$(date -u +%Y%m%d-%H%M%S)"

    if [ -n "$DISK_LIMIT" ]; then
        disk_usage
        case "$DISK_PROBLEM" in
            *DISK_LIMIT*) warn "disk: $DISK_TEXT, over DISK_LIMIT ($DISK_LIMIT); prune after the deploy may help" ;;
        esac
    fi

    say "Cloning ${ref:-$(branch_label)}"
    # Under the lock, so any .building-* folder or BUILDING_FILE left is from a killed run.
    remove_unfinished
    NEW_RELEASE=".building-$stamp"

    if [ -z "$ref" ] && [ -n "$SLOT_PR" ]; then
        # A clone never fetches refs/pull/*, so the head is fetched on its own. Errors are redacted.
        if ! err="$({ git clone --quiet --no-checkout --filter=blob:none "$REPO_URL" "$DEPLOY_BASE/releases/.building-$stamp" \
            && git -C "$DEPLOY_BASE/releases/.building-$stamp" fetch --quiet origin "$(branch_ref)" \
            && git -C "$DEPLOY_BASE/releases/.building-$stamp" checkout --quiet --detach FETCH_HEAD; } 2>&1)"; then
            [ -z "$err" ] || redact "$err" | sed 's/^/    /' >&2
            fail "could not fetch PR #$SLOT_PR from $REPO_URL"
        fi
    elif [ -z "$ref" ]; then
        # Git may print the URL with its token, so its errors are shown redacted.
        if ! err="$(git clone --quiet --depth 1 --branch "$DEPLOY_BRANCH" "$REPO_URL" "$DEPLOY_BASE/releases/.building-$stamp" 2>&1)"; then
            [ -z "$err" ] || redact "$err" | sed 's/^/    /' >&2
            fail "could not clone $REPO_URL"
        fi
    else
        # Any tag, branch or commit: the whole history, with file contents fetched on checkout.
        git clone --quiet --no-checkout --filter=blob:none "$REPO_URL" "$DEPLOY_BASE/releases/.building-$stamp" 2>/dev/null \
            || fail "could not clone $REPO_URL"
        git -C "$DEPLOY_BASE/releases/.building-$stamp" checkout --quiet --detach "$ref" 2>/dev/null \
            || git -C "$DEPLOY_BASE/releases/.building-$stamp" checkout --quiet --detach "origin/$ref" 2>/dev/null \
            || fail "no tag, branch or commit $ref in the repo"

        if [ "$force" -eq 0 ] && [ -n "$live_sha" ] \
            && [ "$(git -C "$DEPLOY_BASE/releases/.building-$stamp" rev-parse HEAD)" = "$live_sha" ]; then
            rm -rf "${DEPLOY_BASE:?}/releases/.building-$stamp"
            NEW_RELEASE=""
            say "$PREVIOUS_RELEASE already runs $ref"
            say "To build it again anyway: deploy ${PROJECT:+$PROJECT }--ref $ref --force"

            return
        fi
    fi
    sha="$(git -C "$DEPLOY_BASE/releases/.building-$stamp" rev-parse --short HEAD)"
    commit_details "$DEPLOY_BASE/releases/.building-$stamp"

    if [ "$force" -eq 1 ]; then
        subject="$(git -C "$DEPLOY_BASE/releases/.building-$stamp" log -1 --format=%s 2>/dev/null || true)"
        forced="--force deploys $sha: $subject"

        if [ -n "$live_sha" ] && [ "$(git -C "$DEPLOY_BASE/releases/.building-$stamp" rev-parse HEAD)" = "$live_sha" ]; then
            forced="--force rebuilds $sha, which $PREVIOUS_RELEASE already runs: $subject"
        fi

        confirm "Build it?" "$forced"
    fi

    if [ -z "$ref" ] && [ -n "$SLOT_PR" ]; then
        TAG="pr$SLOT_PR"
    else
        # A named ref is picked by hand: it keeps its tag in the name, but never waits for one.
        [ -z "$ref" ] || no_wait=1
        wait_release_tag "$DEPLOY_BASE/releases/.building-$stamp" "$no_wait"
    fi

    NEW_RELEASE="$stamp${TAG:+-$TAG}-$sha"
    LOG_RELEASE="$NEW_RELEASE"
    touch "$DEPLOY_BASE/releases/.building-$stamp/$BUILDING_FILE"
    mv "$DEPLOY_BASE/releases/.building-$stamp" "$DEPLOY_BASE/releases/$NEW_RELEASE"
    RELEASE_DIR="$DEPLOY_BASE/releases/$NEW_RELEASE"
    RELEASE_NAME="$NEW_RELEASE"
    export RELEASE_DIR RELEASE_NAME
    say "Building release $NEW_RELEASE"

    shipped_commits "$live_sha" "$RELEASE_DIR"
    [ -z "$SHIPPED" ] || shipped_list | rail

    # The project sends this as the X-App-Version header.
    printf '%s\n' "$NEW_RELEASE" > "$RELEASE_DIR/RELEASE"

    load_conf "$RELEASE_DIR"
    link_shared
    copy_from_live

    local step
    for step in preflight backup build verify; do
        STAGE="$step"
        run_step "$step"
        [ "$RUN_STATUS" -eq 0 ] || fail "$RUN_ERROR"
    done

    STAGE=switch
    rm -f "$RELEASE_DIR/$BUILDING_FILE"
    say "Switching current to $NEW_RELEASE"
    switch_to "$NEW_RELEASE"

    run_step after_switch
    [ "$RUN_STATUS" -eq 0 ] || say "$RUN_ERROR; carrying on"

    STAGE=check
    if is_down; then
        # The maintenance page has no version to check.
        warn "not checking $CHECK_URL: the site is down for maintenance; check it with: deploy ${PROJECT:+$PROJECT }up"
    elif say "Checking $CHECK_URL" && ! release_is_serving "$NEW_RELEASE"; then
        if [ -n "$PREVIOUS_RELEASE" ]; then
            STAGE="check, switched back to $PREVIOUS_RELEASE"
            say "Rolling back to $PREVIOUS_RELEASE"
            switch_to "$PREVIOUS_RELEASE"
            # Requests may still run in it, so set it aside now and delete it on the next deploy.
            mv "$RELEASE_DIR" "$DEPLOY_BASE/releases/.failed-$NEW_RELEASE" 2>/dev/null \
                || warn "could not set $NEW_RELEASE aside"
        fi

        fail "the check failed; ${PREVIOUS_RELEASE:-$NEW_RELEASE, the only release,} is live (data changes stay applied)"
    fi

    prune
    log_event deploy "$NEW_RELEASE" ok
    ACTION=""
    say "Deployed ${PREVIOUS_RELEASE:+$(release_version "$PREVIOUS_RELEASE") → }$(release_version "$NEW_RELEASE")"
}

# Warns when release $2 lacks files that release $1 has in MIGRATIONS_DIR. A hint only.
warn_missing_migrations() {
    local live_dir target_dir file missing=() count

    [ -n "$MIGRATIONS_DIR" ] || return 0
    live_dir="$DEPLOY_BASE/releases/$1/${MIGRATIONS_DIR%/}"
    target_dir="$DEPLOY_BASE/releases/$2/${MIGRATIONS_DIR%/}"
    [ -d "$live_dir" ] && [ -d "$target_dir" ] || return 0

    for file in "$live_dir"/*; do
        [ -e "$file" ] || continue
        file="${file##*/}"
        [ -e "$target_dir/$file" ] || missing+=("$file")
    done

    count="${#missing[@]}"
    [ "$count" -gt 0 ] || return 0
    if [ "$count" -eq 1 ]; then
        warn "the target lacks 1 migration; data is not reverted"
    else
        warn "the target lacks $count migrations; data is not reverted"
    fi
    printf '  %s\n' "${missing[@]:0:10}" | rail >&2
    [ "$count" -le 10 ] || printf '  and %s more\n' "$((count - 10))" | rail >&2
}

rollback() {
    local name="" arg live target note

    for arg in "$@"; do
        case "$arg" in
            --yes | -y) YES=1 ;;
            -*) fail "usage: deploy [project] rollback [name] [--yes]" ;;
            *)
                [ -z "$name" ] || fail "usage: deploy [project] rollback [name] [--yes]"
                name="$arg"
                ;;
        esac
    done

    set -- "$name"
    resolve_base
    refuse_current_folder
    refuse_if_frozen
    require_check_url
    acquire_lock rollback
    remove_unfinished

    live="$(current_release)"
    [ -n "$live" ] || fail "$DEPLOY_BASE/current is not a link; nothing to roll back"

    if [ -n "${1:-}" ]; then
        target="$(find_release "$1")"
        [ "$target" != "$live" ] || fail "$target is already live"
        note="$live is not marked bad"
    else
        target="$(rollback_target "$live")"
        [ -n "$target" ] || fail "no good release older than $live"
        note="$live gets marked bad, so later rollbacks skip it"
    fi

    warn_missing_migrations "$live" "$target"
    confirm "Roll back?" "Rollback of $PROJECT: live $live → $target" "$note"
    DEPLOY_PREVIOUS_RELEASE="$live"
    commit_details "$DEPLOY_BASE/releases/$target"

    if [ -n "${1:-}" ] && is_bad "$target"; then
        rm -f "$DEPLOY_BASE/releases/$target/.bad"
        say "Cleared the bad mark on $target"
    fi

    ACTION=rollback
    LOG_RELEASE="$target"
    STAGE=check
    switch_to "$target"

    # Only a plain rollback says the release it leaves is bad; a named one may go forward.
    if [ -z "${1:-}" ]; then
        if [ -d "$DEPLOY_BASE/releases/$live" ]; then
            if touch "$DEPLOY_BASE/releases/$live/.bad" 2>/dev/null; then
                say "Marked $live as bad; later rollbacks skip it"
            else
                warn "could not mark $live as bad"
            fi
        else
            warn "the folder of $live was missing, so it is not marked bad"
        fi
    fi

    say "Rolled back $(release_version "$live") → $(release_version "$target") (data changes stay applied)"

    RELEASE_DIR="$DEPLOY_BASE/releases/$target"
    RELEASE_NAME="$target"
    export RELEASE_DIR RELEASE_NAME

    if [ -f "$RELEASE_DIR/deploy.conf" ]; then
        if [ -n "$(conf_clashes "$RELEASE_DIR/deploy.conf")" ]; then
            warn "not running after_rollback: deploy.conf of $target uses names of the engine"
        else
            load_conf "$RELEASE_DIR"
            run_step after_rollback
            [ "$RUN_STATUS" -eq 0 ] || warn "$RUN_ERROR; the rollback stands"
        fi
    fi

    if is_down; then
        warn "not checking $CHECK_URL: the site is down for maintenance; check it with: deploy ${PROJECT:+$PROJECT }up"
    else
        say "Checking $CHECK_URL"
        release_is_serving "$target" || fail "$target is linked, but the site does not serve it yet"
    fi
    log_event rollback "$target" "ok, from $live"
    ACTION=""
}

# The Pending line of status: what the next deploy would ship.
show_pending() {
    local more

    pending_commits "$1"

    if [ -z "$PENDING_COUNT" ]; then
        printf 'Pending:   unknown (%s)\n' "$PENDING_NOTE"
    elif [ "$PENDING_COUNT" = 0 ]; then
        printf 'Pending:   none (live is the tip of %s)\n' "$(branch_label)"
    else
        printf 'Pending:   %s commit(s) on %s, not deployed yet\n' "$PENDING_COUNT" "$(branch_label)"
        printf '%s\n' "$PENDING_LOG" | sed -n '1,10s/^/             /p'
        more=$((PENDING_COUNT - 10))
        [ "$more" -le 0 ] || printf '             ... and %s more\n' "$more"
    fi
}

status() {
    resolve_base

    local live previous release failed
    live="$(current_release)"

    [ -z "$PROJECT" ] || printf 'Project:   %s (%s)\n' "$PROJECT" "$DEPLOY_BASE"

    if [ -z "$live" ]; then
        printf 'Live:      none (%s/current is not a link)\n' "$DEPLOY_BASE"
    else
        printf 'Live:      %s\n           deployed %s\n' "$live" "$(release_time "$live")"
        previous="$(rollback_target "$live")"
        printf 'Rollback:  %s\n' "${previous:-none (no good older release)}"
        show_pending "$live"
    fi

    printf '\nReleases, oldest first (keeping %s):\n' "$KEEP_RELEASES"
    for release in $(list_releases); do
        if [ "$release" = "$live" ]; then
            printf '  * %s  (live)\n' "$release"
        elif is_bad "$release"; then
            printf '    %s  (bad; rollback skips it)\n' "$release"
        else
            printf '    %s\n' "$release"
        fi
    done

    for failed in "$DEPLOY_BASE"/releases/.failed-*; do
        [ -e "$failed" ] || continue
        printf '  ! %s  (failed; deleted on the next deploy)\n' "$(basename "$failed")"
    done

    [ ! -f "$DEPLOY_BASE/$FREEZE_FILE" ] || printf '\nFrozen:    %s\n' "$(frozen_text)"
    ! is_down || printf '\nDown:      %s\n' "$(marker_text "$DOWN_FILE")"

    case "$(lock_state)" in
        free) printf '\nLock:      free\n' ;;
        stale) printf '\nLock:      stale (%s; the next deploy removes it)\n' "$(lock_text)" ;;
        held) printf '\nLock:      held (%s)\n' "$(lock_text)" ;;
    esac

    disk_usage
    printf 'Disk:      %s%s\n' "$DISK_TEXT" "${DISK_PROBLEM:+ (${DISK_PROBLEM})}"

    if [ -z "$CHECK_URL" ]; then
        printf 'Site:      not checked (no CHECK_URL)\n'

        return
    fi

    probe
    printf 'Site:      %s answered %s, version %s' "$(redact "$CHECK_URL")" "${PROBE_STATUS:-nothing}" "${PROBE_VERSION:-none}"

    if [ -n "$live" ] && [ "$PROBE_VERSION" = "$live" ]; then
        printf ' (matches live)\n'
    elif is_down && [ "$PROBE_STATUS" = 503 ]; then
        printf ' (down for maintenance)\n'
    else
        printf ' (NOT the live release)\n'
    fi
}

# What status_row and the menu read for the loaded project: ROW_LIVE, ROW_SITE, ROW_SITE_BAD (1 when
# the site does not serve the live release), ROW_PROBLEMS (frozen, down, lock, failed releases), and
# pending_commits on the live release.
project_facts() {
    local failed
    ROW_LIVE="$(current_release)"
    ROW_SITE_BAD=0
    ROW_PROBLEMS=()
    PENDING_COUNT=""
    PENDING_NOTE=""
    PENDING_TIP=""

    if [ -z "$CHECK_URL" ]; then
        ROW_SITE="not checked (no CHECK_URL)"
    else
        probe

        if [ -n "$ROW_LIVE" ] && [ "$PROBE_STATUS" = 200 ] && [ "$PROBE_VERSION" = "$ROW_LIVE" ]; then
            ROW_SITE="200, matches live"
        elif [ -n "$ROW_LIVE" ] && [ "$PROBE_STATUS" = 200 ] && [ "$CHECK_VERSION" = 0 ]; then
            ROW_SITE="200 (version not checked)"
        elif is_down && [ "$PROBE_STATUS" = 503 ]; then
            ROW_SITE="503, down for maintenance"
        else
            ROW_SITE="${PROBE_STATUS:-no answer}, NOT the live release"
            ROW_SITE_BAD=1
        fi
    fi

    [ -z "$ROW_LIVE" ] || pending_commits "$ROW_LIVE"

    [ ! -f "$DEPLOY_BASE/$FREEZE_FILE" ] || ROW_PROBLEMS+=("frozen")
    ! is_down || ROW_PROBLEMS+=("down")

    case "$(lock_state)" in
        stale) ROW_PROBLEMS+=("stale lock") ;;
        held) ROW_PROBLEMS+=("lock held") ;;
    esac

    failed="$(find "$DEPLOY_BASE/releases" -mindepth 1 -maxdepth 1 -name '.failed-*' 2>/dev/null | wc -l | tr -d ' ')"
    [ "$failed" -eq 0 ] || ROW_PROBLEMS+=("$failed failed release(s)")
}

# One tab-separated row for `status --all`. Fails when the site does not serve the live release.
status_row() {
    local time notes=()

    if [ -z "$DEPLOY_BASE" ] || [ ! -d "$DEPLOY_BASE" ]; then
        printf '%s\tnone\t-\t-\t%s\n' "$PROJECT" "no base folder: ${DEPLOY_BASE:-DEPLOY_BASE not set}"

        return 1
    fi

    project_facts
    time="-"
    [ -z "$ROW_LIVE" ] || time="$(release_time "$ROW_LIVE")"

    if [ -n "$ROW_LIVE" ]; then
        if [ -z "$PENDING_COUNT" ]; then
            notes+=("pending unknown")
        elif [ "$PENDING_COUNT" != 0 ]; then
            notes+=("$PENDING_COUNT pending")
        fi
    fi

    printf '%s\t%s\t%s\t%s\t%s\n' "$PROJECT" "${ROW_LIVE:-none}" "$time" "$ROW_SITE" \
        "$(join_notes ${notes[@]+"${notes[@]}"} ${ROW_PROBLEMS[@]+"${ROW_PROBLEMS[@]}"})"

    return "$ROW_SITE_BAD"
}

# One row per project. Each runs in a subshell, so one project's settings never leak into the next.
# The NOTES column: the notes joined with ", ", or "-" when there are none.
join_notes() {
    local text="" note

    for note in "$@"; do
        text+="${text:+, }$note"
    done

    printf '%s' "${text:--}"
}

# The engine's own row for status --all: its version, when its commit was made, and whether the
# repo has newer ones. Fetching only updates the engine's remote refs, never its files.
engine_row() {
    local stamp behind notes=()

    if ! git -C "$ENGINE_DIR" rev-parse --short HEAD > /dev/null 2>&1; then
        printf 'release-switch\t-\t-\t-\tnot a git checkout\n'

        return
    fi

    stamp="$(TZ=UTC git -C "$ENGINE_DIR" log -1 --format=%cd --date=format-local:%Y%m%d%H%M%S)"

    if ! git -C "$ENGINE_DIR" fetch --quiet 2>/dev/null; then
        notes+=("cannot reach the repo")
    elif ! behind="$(git -C "$ENGINE_DIR" rev-list --count 'HEAD..@{upstream}' 2>/dev/null)"; then
        notes+=("no upstream branch")
    elif [ "$behind" -gt 0 ]; then
        notes+=("$behind new, run deploy self")
    else
        notes+=("up to date")
    fi

    [ -z "$(git -C "$ENGINE_DIR" status --porcelain --untracked-files=no)" ] || notes+=("local changes")

    printf 'release-switch\t%s\t%s\t-\t%s\n' "$(engine_version)" "$(release_time "$stamp")" "$(join_notes "${notes[@]}")"
}

status_all() {
    local project row rows="" failed=0

    for project in $(list_projects); do
        if row="$(load_project "$project" && apply_defaults && status_row)"; then
            :
        else
            failed=1
        fi

        rows+="$row"$'\n'
    done

    [ -n "$rows" ] || fail "no projects in $PROJECTS_DIR (copy example.env)"

    # The first project's settings give the engine row its PHP and time zone.
    rows+="$(load_project "$(list_projects | head -n1)" && apply_defaults && engine_row)"$'\n'

    rows="$(printf 'PROJECT\tLIVE\tDEPLOYED\tSITE\tNOTES\n%s' "$rows")"

    if command -v column > /dev/null; then
        printf '%s\n' "$rows" | column -t -s $'\t'
    else
        printf '%s\n' "$rows"
    fi

    return "$failed"
}

# Loads project or slot $1 the way `deploy $1` does.
menu_load() {
    load_project "$1"
    apply_defaults
    [ -z "$DEPLOY_SLOT" ] || apply_slot
}

# The branch slot $1 follows, empty when free. Changes the settings to the slot's, so it runs in a
# subshell.
slot_branch() {
    DEPLOY_SLOT="$1"
    apply_slot
    printf '%s' "$SLOT_BRANCH"
}

# The staging slots of the loaded project, one per line: sN when it follows a branch, sN:free when not.
menu_slots() {
    local i branch

    for ((i = 1; i <= STAGING_SERVERS; i++)); do
        branch="$(slot_branch "s$i")"
        if [ -n "$branch" ]; then
            printf 's%s\n' "$i"
        else
            printf 's%s:free\n' "$i"
        fi
    done
}

# One tab-separated menu row for the loaded project or slot: 1 when it has something to ship (else
# 0), the target (the project), the name (the project, or sN for a slot), the version, the pending commits, the site and the
# problems. An empty field is "-".
menu_row() {
    local version pending site live_version ship=0 problems=()

    if [ -z "$DEPLOY_BASE" ] || [ ! -d "$DEPLOY_BASE" ]; then
        printf '0\t%s\t%s\t-\t-\t-\tno base folder\n' "$PROJECT" "${DEPLOY_SLOT:-$PROJECT}"

        return
    fi

    project_facts
    live_version="none"
    [ -z "$ROW_LIVE" ] || live_version="$(release_version "$ROW_LIVE")"
    version="$live_version"
    [ -z "$DEPLOY_SLOT" ] || version="$(branch_label)"

    if [ -z "$ROW_LIVE" ]; then
        pending="not deployed yet"
        ship=1
    elif [ -z "$PENDING_COUNT" ]; then
        pending="unknown"
        problems+=("$PENDING_NOTE")
    elif [ "$PENDING_COUNT" = 0 ]; then
        pending="up to date"
    else
        ship=1
        pending="$PENDING_COUNT commits"
        [ "$PENDING_COUNT" != 1 ] || pending="1 commit"

        if [ -z "$DEPLOY_SLOT" ]; then
            release_refs "$PENDING_TIP"

            if [ -n "$TAG" ]; then
                version="$live_version → $TAG"
            elif [ "$HAS_TAGS" -eq 1 ] && [ "$NO_RELEASE" -eq 0 ]; then
                pending="$pending, no tag yet"
            fi
        fi
    fi

    case "$ROW_SITE" in
        "200, "* | "200 "*) site="site ok" ;;
        "not checked"*) site="site not checked" ;;
        *) site="site ${ROW_SITE%%,*}" ;;
    esac
    [ "$ROW_SITE_BAD" -eq 0 ] || problems+=("site not on the live release")

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$ship" "$PROJECT" "${DEPLOY_SLOT:-$PROJECT}" "$version" "$pending" "$site" \
        "$(join_notes ${problems[@]+"${problems[@]}"} ${ROW_PROBLEMS[@]+"${ROW_PROBLEMS[@]}"})"
}

# The engine's menu row, in the format of menu_row, with the target "self". Fetching only updates
# the engine's remote refs, never its files.
engine_menu_row() {
    local version behind pending="up to date" ship=0 problems=()
    version="$(engine_version)"

    if ! git -C "$ENGINE_DIR" fetch --quiet 2>/dev/null; then
        problems+=("cannot reach the repo")
    elif ! behind="$(git -C "$ENGINE_DIR" rev-list --count 'HEAD..@{upstream}' 2>/dev/null)"; then
        problems+=("no upstream branch")
    elif [ "$behind" -gt 0 ]; then
        ship=1
        version="$version → $(engine_version '@{upstream}')"
        pending="run deploy self"
    fi

    printf '%s\tself\trelease-switch\t%s\t%s\t-\t%s\n' "$ship" "$version" "$pending" \
        "$(join_notes ${problems[@]+"${problems[@]}"})"
}

# Gives the terminal back: its settings and the cursor.
menu_restore() {
    [ -n "$MENU_STTY" ] || return 0
    stty "$MENU_STTY" 2>/dev/null || true
    printf '\033[?25h'
    MENU_STTY=""
}

menu_cleanup() {
    # shellcheck disable=SC2086 # One pid per word.
    [ -z "$MENU_PIDS" ] || kill $MENU_PIDS 2>/dev/null || true
    MENU_PIDS=""
    [ -z "$MENU_TMP" ] || rm -rf "$MENU_TMP"
    MENU_TMP=""
    menu_restore
}

# How many columns $1 takes: bytes, with each → (3 bytes) as one.
text_width() {
    local LC_ALL=C
    local plain="${1//→/}"
    printf '%s' $((${#plain} + (${#1} - ${#plain}) / 3))
}

# $1 padded with spaces to $2 columns.
pad() {
    printf '%s%*s' "$1" $(($2 - $(text_width "$1"))) ''
}

# Line $1 of the menu (0 is the first), with ❯ in front when $2 is 1. Production names are bold; slots
# hang under their project on dim tree lines.
menu_line() {
    local i="$1" mark="  " color="" name version pending site problems
    name="${M_NAME[$i]}"
    version="${M_VERSION[$i]}"
    pending="${M_PENDING[$i]}"
    site="${M_SITE[$i]}"
    problems="${M_PROBLEMS[$i]}"
    [ "$version" != - ] || version=""
    [ "$pending" != - ] || pending=""
    [ "$site" != - ] || site=""
    [ "$problems" != - ] || problems=""

    [ "${M_SHIP[$i]}" -eq 1 ] || color="$C_DIM"
    if [ "${2:-0}" -eq 1 ]; then
        mark="$C_GREEN❯$C_OFF "
        color="$C_BOLD"
    fi

    if [ -n "${M_TREE[$i]}" ]; then
        name="$C_DIM${M_TREE[$i]}$C_OFF$color $(pad "$name" $((W_NAME - 2)))"
    else
        name="$C_BOLD$(pad "$name" "$W_NAME")$C_OFF$color"
    fi

    printf '%s%s%s  %s  %s  %s  %s%s%s%s%s' "$mark" "$color" "$(pad "${M_NUM[$i]}" ${#M_PICKS})" \
        "$name" "$(pad "$version" "$W_VERSION")" "$(pad "$pending" "$W_PENDING")" \
        "$(pad "$site" "$W_SITE")" "$C_OFF" "${problems:+  $C_RED}" "$problems" "${problems:+$C_OFF}"
}

# Prints the menu rows on the rail, with ❯ at pick $1, then the key hint.
menu_draw() {
    local i prefix="  "
    [ "$RAILS" -eq 0 ] || prefix="$C_DIM│$C_OFF  "

    for ((i = 0; i < M_COUNT; i++)); do
        printf '\r\033[K%s%s\n' "$prefix" "$(menu_line "$i" $((i == M_SEL[$1])))"
    done

    printf '\r\033[K%s\n\r\033[K%s%s↑↓ or 1–%s to pick · enter to deploy · q to quit%s\n' "${prefix%  }" \
        "$prefix" "$C_DIM" "$M_PICKS" "$C_OFF"
}

# Lets the user pick a row with the arrow keys, j/k, a number and enter. Sets M_PICK to the line, or
# exits on q or Esc. Free slots cannot be picked.
menu_keys() {
    local key rest wait=1 pick=0
    # bash 3.2 reads whole seconds only, so Esc on its own waits a second there.
    [ "${BASH_VERSINFO[0]}" -lt 4 ] || wait=0.1

    MENU_STTY="$(stty -g 2>/dev/null)" || MENU_STTY=""
    [ -n "$MENU_STTY" ] || MENU_STTY="sane"
    printf '\033[?25l'
    menu_draw "$pick"

    while :; do
        IFS= read -rsn1 key || key=q

        case "$key" in
            $'\033')
                rest=""
                IFS= read -rsn2 -t "$wait" rest || true

                case "$rest" in
                    '[A' | OA) key=k ;;
                    '[B' | OB) key=j ;;
                    '') key=q ;;
                esac
                ;;
        esac

        case "$key" in
            k) [ "$pick" -eq 0 ] || pick=$((pick - 1)) ;;
            j) [ "$pick" -eq $((M_PICKS - 1)) ] || pick=$((pick + 1)) ;;
            [1-9]) [ "$key" -gt "$M_PICKS" ] || pick=$((key - 1)) ;;
            '') break ;;
            q | Q)
                menu_restore
                say "Nothing done"
                exit 0
                ;;
        esac

        printf '\033[%sA' $((M_COUNT + 2))
        menu_draw "$pick"
    done

    menu_restore
    M_PICK="${M_SEL[$pick]}"
}

# Without cursor control: a numbered list and "Pick 1–N:". Sets M_PICK to the line, or exits on q, an empty
# answer or the end of input.
menu_numbers() {
    local i answer

    for ((i = 0; i < M_COUNT; i++)); do
        printf '%s\n' "$(menu_line "$i")"
    done | rail

    while :; do
        printf '%s' "$(say "Pick 1–$M_PICKS: ")"
        read -r answer || answer=""

        case "$answer" in
            "" | q | Q)
                say "Nothing done"
                exit 0
                ;;
            *[!0-9]*) ;;
            *)
                if [ "$answer" -ge 1 ] && [ "$answer" -le "$M_PICKS" ]; then
                    M_PICK="${M_SEL[$((answer - 1))]}"

                    return
                fi
                ;;
        esac

        warn "no such choice: $answer"
    done
}

# A bare `deploy` on a terminal: one row per project, its slots in use as a tree under it, one leaf
# for its free slots, and the engine, read in parallel. The picked one shows its pending commits,
# asks, then runs as `deploy <project>`, `deploy <project>@sN` or `deploy self`.
project_menu() {
    local targets=() groups=() subs=() frees=() pships=() project slot free group=-1 i row width rows=""
    local ship target name version pending site problems engine sub
    M_NAME=() M_VERSION=() M_PENDING=() M_SITE=() M_PROBLEMS=() M_SHIP=() M_TARGET=() M_GROUP=() M_SUB=()
    M_TREE=() M_NUM=() M_SEL=()

    intro ""

    for project in $(list_projects); do
        group=$((group + 1))
        targets+=("$project")
        groups+=("$group")
        subs+=(0)
        free=""

        for slot in $(menu_load "$project" 2> /dev/null && menu_slots 2> /dev/null || true); do
            case "$slot" in
                *:free) free+="${free:+, }${slot%:free}" ;;
                *)
                    targets+=("$project@$slot")
                    groups+=("$group")
                    subs+=("${slot#s}")
                    ;;
            esac
        done

        frees+=("$free")
    done

    say "Checking ${#targets[@]} projects…"
    MENU_TMP="$(mktemp -d)"

    for i in "${!targets[@]}"; do
        (menu_load "${targets[$i]}" && menu_row) < /dev/null > "$MENU_TMP/$i" 2> /dev/null &
        MENU_PIDS+=" $!"
    done

    engine_menu_row < /dev/null > "$MENU_TMP/engine" 2> /dev/null &
    MENU_PIDS+=" $!"
    wait
    MENU_PIDS=""

    # A project comes before its slots, so its ship flag is known when they are read.
    for i in "${!targets[@]}"; do
        row="$(cat "$MENU_TMP/$i")"
        name="${targets[$i]}"
        [ "${subs[$i]}" -eq 0 ] || name="s${subs[$i]}"
        [ -n "$row" ] || row="$(printf '0\t%s\t%s\t-\t-\t-\tcannot read' "${targets[$i]}" "$name")"
        group="${groups[$i]}"
        [ "${subs[$i]}" -ne 0 ] || pships[group]="${row%%$'\t'*}"
        rows+="${pships[$group]}"$'\t'"$group"$'\t'"${subs[$i]}"$'\t'"$row"$'\n'
    done

    for group in "${!frees[@]}"; do
        [ -z "${frees[$group]}" ] \
            || rows+="${pships[$group]}"$'\t'"$group"$'\t'"9999"$'\t'"0"$'\t-\t'"${frees[$group]}"$'\tfree\t-\t-\t-\n'
    done

    # Projects with something to ship first, else in their order; slots under their project in slot
    # order, free ones last; the engine last.
    rows="$(printf '%s' "$rows" | sort -t $'\t' -k1,1r -k2,2n -k3,3n)"
    engine="$(cat "$MENU_TMP/engine")"
    [ -n "$engine" ] || engine="$(printf '0\tself\trelease-switch\t%s\t-\t-\tcannot read' "$(engine_version)")"
    rows+=$'\n'"-"$'\t'"-"$'\t'"-"$'\t'"$engine"
    rm -rf "$MENU_TMP"
    MENU_TMP=""

    while IFS=$'\t' read -r _ group sub ship target name version pending site problems; do
        M_GROUP+=("$group")
        M_SUB+=("$sub")
        M_SHIP+=("$ship")
        M_TARGET+=("$target")
        M_NAME+=("$name")
        M_VERSION+=("$version")
        M_PENDING+=("$pending")
        M_SITE+=("$site")
        M_PROBLEMS+=("$problems")
    done <<< "$rows"

    M_COUNT="${#M_NAME[@]}"
    for ((i = 0; i < M_COUNT; i++)); do
        case "${M_SUB[$i]}" in
            0 | -) M_TREE+=("") ;;
            *)
                if [ $((i + 1)) -lt "$M_COUNT" ] && [ "${M_GROUP[$((i + 1))]}" = "${M_GROUP[$i]}" ]; then
                    M_TREE+=("├")
                else
                    M_TREE+=("└")
                fi
                ;;
        esac

        if [ "${M_TARGET[$i]}" = - ]; then
            M_NUM+=("")
        else
            M_SEL+=("$i")
            M_NUM+=("${#M_SEL[@]}")
        fi
    done
    M_PICKS="${#M_SEL[@]}"

    W_NAME=0 W_VERSION=0 W_PENDING=0 W_SITE=0
    for ((i = 0; i < M_COUNT; i++)); do
        width="$(text_width "${M_NAME[$i]}")"
        [ -z "${M_TREE[$i]}" ] || width=$((width + 2))
        [ "$width" -le "$W_NAME" ] || W_NAME="$width"
        width="$(text_width "${M_VERSION[$i]#-}")"
        [ "$width" -le "$W_VERSION" ] || W_VERSION="$width"
        width="$(text_width "${M_PENDING[$i]#-}")"
        [ "$width" -le "$W_PENDING" ] || W_PENDING="$width"
        width="$(text_width "${M_SITE[$i]#-}")"
        [ "$width" -le "$W_SITE" ] || W_SITE="$width"
    done

    if [ "$RAILS" -eq 1 ]; then
        printf '%s◆%s  Which project to deploy?\n' "$C_GREEN" "$C_OFF"
    else
        say "Which project to deploy?"
    fi

    case "${TERM:-dumb}" in
        dumb | unknown) menu_numbers ;;
        *) menu_keys ;;
    esac

    target="${M_TARGET[$M_PICK]}"
    name="${M_NAME[$M_PICK]}"
    version="${M_VERSION[$M_PICK]}"
    [ "$version" != - ] || version=""

    if [ "$target" = self ]; then
        { git -C "$ENGINE_DIR" log --format='%h %s' 'HEAD..@{upstream}' 2> /dev/null || true; } | rail
        ask_yes "Update the engine${version:+ $version}?" || { say "Nothing done"; exit 0; }
    else
        (
            menu_load "$target"
            [ -z "$(current_release)" ] || show_pending "$(current_release)"
        ) 2>&1 | rail
        case "$target" in
            *@*) name="${target%@*} ${target#*@} (staging)" ;;
            *) name="$name (production)" ;;
        esac
        ask_yes "Deploy $name${version:+ $version}?" || { say "Nothing done"; exit 0; }
    fi

    menu_cleanup
    [ "$RAILS" -eq 0 ] || printf '%s└%s\n' "$C_DIM" "$C_OFF"
    exec "$BASH" "$ENGINE_DIR/$(basename "${BASH_SOURCE[0]}")" "$target"
}

# Moves one path into shared/ and leaves a link behind, so the old checkout keeps working.
# For check: one line per item. Problems go to stderr, so cron can mail only those.
check_ok() {
    printf 'ok    %s%s\n' "${PROJECT:+$PROJECT: }" "$(redact "$*")"
}

check_bad() {
    printf 'FAIL  %s%s\n' "${PROJECT:+$PROJECT: }" "$(redact "$*")" >&2
    CHECK_FAILED=1
    CHECK_PROBLEMS+="${CHECK_PROBLEMS:+; }$(redact "$*")"
    # The part before ":" names the problem; the rest (like minutes) may change each run.
    CHECK_KEYS+="${*%%:*}"$'\n'
}

# Alerts only when the check result changes, so a cron check does not repeat itself.
# Remembers the last failure in <base>/.check-failed. With no base folder, in
# <projects>/.<project>.check-failed instead, so check never makes the base folder.
check_notify() {
    local state="$DEPLOY_BASE/.check-failed" spare last
    spare="$PROJECTS_DIR/.${PROJECT:-default}${DEPLOY_SLOT:+@$DEPLOY_SLOT}.check-failed"

    [ -n "$NOTIFY_URL$NOTIFY_CMD" ] || return 0
    [ -n "$DEPLOY_BASE" ] && [ -d "$DEPLOY_BASE" ] || state="$spare"

    if [ -f "$spare" ]; then
        last="$(cat "$spare" 2>/dev/null || true)"
    else
        last="$(cat "$state" 2>/dev/null || true)"
    fi

    if [ "$CHECK_FAILED" -eq 1 ]; then
        if [ "$last" != "${CHECK_KEYS%$'\n'}" ]; then
            notify check "check failed: $CHECK_PROBLEMS" problem "$(current_release)"
            printf '%s' "$CHECK_KEYS" 2>/dev/null > "$state" || warn "could not write $state"
            [ "$state" = "$spare" ] || rm -f "$spare" 2>/dev/null || true
        fi
    elif [ -f "$state" ] || [ -f "$spare" ]; then
        notify check "check ok again" ok "$(current_release)"
        rm -f "$state" "$spare" 2>/dev/null || true
    fi
}

# Runs the project's optional health() step from the live release's deploy.conf, in that
# release. A non-zero exit is a problem; the last line it prints says why.
check_health() {
    local dir="$1" output last status

    # shellcheck source=/dev/null
    (cd "$dir" && . ./deploy.conf > /dev/null 2>&1 && declare -F health > /dev/null) || return 0
    output="$(mktemp)"

    # Off here, so `set -e` inside the subshell stops the step at its first failing command.
    set +e
    run_limited "$STEP_TIMEOUT" health_body "$dir" > "$output" 2>&1
    status=$?
    set -e

    last="$(sed '/^[[:space:]]*$/d' "$output" | tail -n1)"
    rm -f "$output"

    if [ "$TIMED_OUT" -eq 1 ]; then
        check_bad "health: ran past STEP_TIMEOUT ($STEP_TIMEOUT s)"
    elif [ "$status" -eq 0 ]; then
        check_ok "health: ${last:-ok}"
    else
        check_bad "health: ${last:-failed with exit code $status}"
    fi
}

health_body() {
    (
        set -e
        cd "$1"
        RELEASE_DIR="$1"
        RELEASE_NAME="$(basename "$1")"
        export RELEASE_DIR RELEASE_NAME
        # shellcheck source=/dev/null
        . ./deploy.conf > /dev/null 2>&1
        health
    )
}

# A health check. Changes nothing, apart from remembering the last alert. Exits with 1 if
# anything is wrong.
check() {
    local live dir broken minutes
    CHECK_FAILED=0
    CHECK_PROBLEMS=""
    CHECK_KEYS=""

    if [ -z "$DEPLOY_BASE" ] || [ ! -d "$DEPLOY_BASE" ]; then
        check_bad "no base folder: ${DEPLOY_BASE:-DEPLOY_BASE not set}"
        check_notify

        return 1
    fi

    DEPLOY_BASE="$(cd "$DEPLOY_BASE" && pwd -P)"
    live="$(current_release)"
    dir="$DEPLOY_BASE/releases/$live"

    if [ -z "$live" ]; then
        check_bad "no live release ($DEPLOY_BASE/current is not a link)"
    elif [ ! -d "$dir" ]; then
        check_bad "current points at $live, which is missing"
    else
        check_ok "live: $live"

        if [ -f "$dir/deploy.conf" ]; then
            # A link into shared/ that points at nothing breaks the app quietly.
            # shellcheck source=/dev/null
            broken="$(cd "$dir" && SHARED=() && . ./deploy.conf > /dev/null 2>&1 \
                && for path in ${SHARED[@]+"${SHARED[@]}"}; do [ -e "$path" ] || printf '%s ' "$path"; done)" \
                || broken="deploy.conf does not load "

            if [ -n "$broken" ]; then
                check_bad "shared: missing ${broken% }"
            else
                check_ok "shared: all present"
            fi

            # The app may stop its scheduler while down, so health() would fail for no real reason.
            if is_down; then
                check_ok "health: not checked, down for maintenance"
            else
                check_health "$dir"
            fi
        fi
    fi

    if [ -z "$CHECK_URL" ]; then
        check_ok "site: not checked (no CHECK_URL)"
    else
        probe

        if [ -n "$live" ] && [ "$PROBE_STATUS" = 200 ] && [ "$PROBE_VERSION" = "$live" ]; then
            check_ok "site: 200, matches live"
        elif [ -n "$live" ] && [ "$PROBE_STATUS" = 200 ] && [ "$CHECK_VERSION" = 0 ]; then
            check_ok "site: 200 (version not checked)"
        elif is_down && [ "$PROBE_STATUS" = 503 ]; then
            check_ok "site: 503, down for maintenance"
        else
            check_bad "site: $CHECK_URL answered ${PROBE_STATUS:-nothing}, version ${PROBE_VERSION:-none}"
        fi
    fi

    disk_usage

    if [ -n "$DISK_PROBLEM" ]; then
        check_bad "disk: $DISK_TEXT; $DISK_PROBLEM"
    else
        check_ok "disk: $DISK_TEXT"
    fi

    [ ! -f "$DEPLOY_BASE/$FREEZE_FILE" ] || check_ok "frozen $(frozen_text)"
    ! is_down || check_ok "down for maintenance $(marker_text "$DOWN_FILE")"

    case "$(lock_state)" in
        free)
            check_ok "lock: free"
            ;;
        stale)
            # No owner: a run died while taking it.
            if [ -z "$(lock_owner)" ]; then
                check_bad "lock: stale ($(lock_text)); the next deploy removes it"
            else
                check_ok "lock: stale ($(lock_text)); the next deploy removes it"
            fi
            ;;
        held)
            minutes="$(lock_text | sed -nE 's/.* ([0-9]+) min$/\1/p')"

            if [ "${minutes:-0}" -ge 30 ]; then
                check_bad "lock: held for ${minutes} min ($(lock_text)); a deploy may be stuck"
            else
                check_ok "lock: held ($(lock_text))"
            fi
            ;;
    esac

    check_notify

    return "$CHECK_FAILED"
}

# One tab-separated row for `slots`: slot $1, its branch, live sha, deploy time and URL. The branch
# gets "(gone)" when $2 is 1; a free slot with a live release shows "free (<DEPLOY_BRANCH>)". Changes the settings to the slot's, so it runs in a subshell.
slot_row() {
    local live="" sha="-" time="-"

    DEPLOY_SLOT="$1"
    apply_slot

    [ ! -d "$DEPLOY_BASE" ] || live="$(current_release)"

    if [ -n "$live" ]; then
        sha="$(git -C "$DEPLOY_BASE/current" rev-parse --short HEAD 2>/dev/null || printf -- -)"
        time="$(release_time "$live")"
    fi

    [ -z "$SLOT_PR" ] || SLOT_BRANCH="PR #$SLOT_PR"
    [ "${2:-0}" -eq 0 ] || SLOT_BRANCH="$SLOT_BRANCH (gone)"
    [ -n "$SLOT_BRANCH" ] || [ -z "$live" ] || SLOT_BRANCH="free ($DEPLOY_BRANCH)"
    printf '%s\t%s\t%s\t%s\t%s\n' "$DEPLOY_SLOT" "${SLOT_BRANCH:-free}" "$sha" "$time" "$(redact "${CHECK_URL:--}")"
}

# For commands on all slots of a project ($1: slots, stage, ...): refuses a slot name and a
# project without slots.
require_slots() {
    [ -z "$DEPLOY_SLOT" ] || fail "$1 works on the whole project, not one slot: deploy ${PROJECT%@*} $1"
    [ -n "$PROJECT" ] || fail "name a project: deploy <project> $1"
    [ "$STAGING_SERVERS" -gt 0 ] \
        || fail "$PROJECT has no staging slots (set STAGING_SERVERS in $PROJECTS_DIR/$PROJECT.env)"
}

# The remote ref of slot branch $1: refs/pull/<N>/head for pr/<N>, else refs/heads/<name>.
slot_ref() {
    if is_pr_branch "$1"; then
        printf 'refs/pull/%s/head' "${1#pr/}"
    else
        printf 'refs/heads/%s' "$1"
    fi
}

# Reads the branch of each slot into SLOT_BRANCHES (s1 first, empty when free), and sets SLOT_GONE
# to 1 for each one the repo no longer has. One git ls-remote for all; when it cannot read the repo,
# no branch counts as gone.
read_slot_branches() {
    local i branch refs=() found repo
    SLOT_BRANCHES=()
    SLOT_GONE=()

    for ((i = 1; i <= STAGING_SERVERS; i++)); do
        branch="$(DEPLOY_SLOT="s$i" && apply_slot && printf '%s' "$SLOT_BRANCH")"
        SLOT_BRANCHES+=("$branch")
        [ -z "$branch" ] || refs+=("$(slot_ref "$branch")")
    done

    repo="${REPO_URL:-$(git -C "$DEPLOY_BASE/current" remote get-url origin 2>/dev/null || true)}"

    if [ ${#refs[@]} -eq 0 ] || [ -z "$repo" ] \
        || ! found="$(git ls-remote "$repo" "${refs[@]}" 2>/dev/null | cut -f2)"; then
        found=""
        repo=""
    fi

    for branch in "${SLOT_BRANCHES[@]}"; do
        if [ -z "$branch" ] || [ -z "$repo" ]; then
            SLOT_GONE+=(0)
            continue
        fi

        case $'\n'"$found"$'\n' in
            *$'\n'"$(slot_ref "$branch")"$'\n'*) SLOT_GONE+=(0) ;;
            *) SLOT_GONE+=(1) ;;
        esac
    done
}

# One row per staging slot. Each runs in a subshell, so one slot's settings never leak into the next.
show_slots() {
    local i rows=""

    require_slots slots
    read_slot_branches

    for ((i = 1; i <= STAGING_SERVERS; i++)); do
        rows+="$(slot_row "s$i" "${SLOT_GONE[$((i - 1))]}")"$'\n'
    done

    rows="$(printf 'SLOT\tBRANCH\tLIVE\tDEPLOYED\tURL\n%s' "$rows")"

    if command -v column > /dev/null; then
        printf '%s\n' "$rows" | column -t -s $'\t'
    else
        printf '%s\n' "$rows"
    fi
}

# Deploys a branch (or --pr <N>) to the slot that already follows it, else to the first free slot,
# else to the first slot whose branch is gone from the repo. Then prints the slot's URL last.
stage() {
    local branch="" pr="" want i slot="" following="" free="" gone="" usage="usage: deploy <project> stage <branch> | --pr <number>"

    require_slots stage

    case "${1:-}" in
        --pr) pr="${2:-}" && shift ;;
        --pr=*) pr="${1#--pr=}" ;;
        -*) fail "$usage" ;;
        *) branch="${1:-}" ;;
    esac
    [ $# -le 1 ] && [ -n "$branch$pr" ] || fail "$usage"
    [ -z "$pr" ] || [[ "$pr" =~ ^[1-9][0-9]*$ ]] || fail "--pr takes a pull request number, not '$pr'"
    want="${branch:-pr/$pr}"
    read_slot_branches

    for ((i = 1; i <= STAGING_SERVERS; i++)); do
        if [ "${SLOT_BRANCHES[$((i - 1))]}" = "$want" ]; then
            following="s$i"
        elif [ -z "${SLOT_BRANCHES[$((i - 1))]}" ]; then
            free+=" s$i"
        elif [ "${SLOT_GONE[$((i - 1))]}" -eq 1 ]; then
            gone+=" s$i"
        fi
    done

    # Each slot is taken under its lock, so two runs never pick the same one.
    if [ -n "$following" ]; then
        claim_slot "$following" "$want" "$want" \
            || fail "$PROJECT@$following follows $want, but another run holds its lock; try again when it is done"
        slot="$following"
    fi

    for i in $free; do
        [ -z "$slot" ] || break
        ! claim_slot "$i" "" "$want" || slot="$i"
    done

    for i in $gone; do
        [ -z "$slot" ] || break

        if claim_slot "$i" "${SLOT_BRANCHES[$((${i#s} - 1))]}" "$want"; then
            slot="$i"
            say "No free slot; $PROJECT@$i follows ${SLOT_BRANCHES[$((${i#s} - 1))]}, which is gone from the repo, so it takes $want"
        fi
    done

    if [ -z "$slot" ]; then
        show_slots | rail >&2
        fail "all $STAGING_SERVERS slots are busy; free one first: deploy $PROJECT@sN free"
    fi

    DEPLOY_SLOT="$slot"
    apply_slot

    if [ -n "$pr" ]; then
        deploy --pr "$pr"
    else
        deploy --branch "$branch"
    fi

    if [ "$RAILS" -eq 1 ]; then
        say "$PROJECT: $(redact "$CHECK_URL")"
    else
        redact "$CHECK_URL"
        printf '\n'
    fi
}

# Takes the lock of slot $1 for stage when nobody holds it, and keeps it for the deploy. Keeps it
# only while the slot's BRANCH is still $2 (empty: free) or already $3; else lets it go and fails.
claim_slot() {
    local base followed

    base="$(DEPLOY_SLOT="$1" && apply_slot && mkdir -p "$DEPLOY_BASE" && cd "$DEPLOY_BASE" && pwd -P)" || return 1
    mkdir "$base/.deploy.lock" 2>/dev/null || return 1
    LOCK_DIR="$base/.deploy.lock"
    # Called in a condition, so `set -e` does not stop a lock with no owner.
    if ! printf '%s %s stage\n' "$$" "$(date +%s)" 2>/dev/null > "$LOCK_DIR/owner.$$" \
        || ! mv "$LOCK_DIR/owner.$$" "$LOCK_DIR/owner" 2>/dev/null; then
        rm -rf "$LOCK_DIR"
        LOCK_DIR=""
        fail "could not write the lock owner in $base/.deploy.lock"
    fi
    followed="$(cat "$base/BRANCH" 2>/dev/null || true)"

    if [ "$followed" = "$2" ] || [ "$followed" = "$3" ]; then
        return 0
    fi

    rm -rf "$LOCK_DIR"
    LOCK_DIR=""

    return 1
}

# Forgets the branch of the slot, then deploys the newest DEPLOY_BRANCH to it, under one lock.
free_slot() {
    local followed

    resolve_base
    acquire_lock free
    # Read under the lock: a deploy may have changed it since.
    followed="$(cat "$DEPLOY_BASE/BRANCH" 2>/dev/null || true)"

    if [ -z "$followed" ]; then
        say "$PROJECT is already free; deploying $DEPLOY_BRANCH"
    else
        ! is_pr_branch "$followed" || followed="PR #${followed#pr/}"
        rm -f "$DEPLOY_BASE/BRANCH"
        DEPLOY_BRANCH="$PROD_DEPLOY_BRANCH"
        SLOT_BRANCH=""
        SLOT_PR=""
        log_event free "$(current_release)" "ok, was $followed"
        say "$PROJECT is free now (it followed $followed); deploying $DEPLOY_BRANCH"
    fi

    deploy
}

# True when SHARED path $1 is an env file: .env, *.env or .env.*. copy-from never copies one.
is_env_path() {
    case "${1##*/}" in
        .env | *.env | .env.*) return 0 ;;
    esac

    return 1
}

# Copies SHARED paths from production's shared/ into the slot's shared/, never an env file. Asks
# first on a terminal, unless --yes. Each path is copied to a temp name and renamed into place.
copy_from() {
    local source="" yes=0 arg conf conf_label shared_text path wanted=() paths=() from to old size
    local usage="usage: deploy <project>@sN copy-from <project> [--yes] [path ...]"

    for arg in "$@"; do
        case "$arg" in
            --yes | -y) yes=1 ;;
            -*) fail "$usage" ;;
            *)
                if [ -z "$source" ]; then
                    source="$arg"
                else
                    wanted+=("${arg%/}")
                fi
                ;;
        esac
    done

    [ -n "$source" ] || fail "$usage"
    case "$source" in
        *@*) fail "copy-from copies from production only, not from a slot: deploy $PROJECT copy-from ${PROJECT%@*}" ;;
    esac
    [ "$source" = "${PROJECT%@*}" ] \
        || fail "copy-from copies from production of the same project only: deploy $PROJECT copy-from ${PROJECT%@*}"
    [ -d "$PROD_BASE/shared" ] || fail "$source has no shared folder ($PROD_BASE/shared)"
    PROD_BASE="$(cd "$PROD_BASE" && pwd -P)"

    resolve_base

    if [ -f "$DEPLOY_BASE/current/deploy.conf" ]; then
        conf="$DEPLOY_BASE/current/deploy.conf"
        conf_label="the slot's live release"
    elif [ -f "$PROD_BASE/current/deploy.conf" ]; then
        conf="$PROD_BASE/current/deploy.conf"
        conf_label="production's live release (the slot has none yet)"
    else
        fail "no live deploy.conf in $PROJECT or $source to read SHARED from"
    fi

    # Only SHARED is needed, so the steps are not loaded into this shell.
    # shellcheck source=/dev/null
    shared_text="$(SHARED=() && . "$conf" && printf '%s\n' ${SHARED[@]+"${SHARED[@]}"})" \
        || fail "cannot read SHARED from $conf"
    say "SHARED from $conf_label"

    if [ ${#wanted[@]} -eq 0 ]; then
        while IFS= read -r path; do
            [ -n "$path" ] || continue
            is_env_path "$path" || paths+=("$path")
        done <<< "$shared_text"
    else
        for path in "${wanted[@]}"; do
            ! is_env_path "$path" || fail "copy-from never copies $path; give the slot its own"

            case $'\n'"$shared_text"$'\n' in
                *$'\n'"$path"$'\n'*) paths+=("$path") ;;
                *) fail "$path is not in SHARED ($(printf '%s' "$shared_text" | paste -sd ' ' -))" ;;
            esac
        done
    fi

    [ ${#paths[@]} -gt 0 ] || fail "SHARED has nothing to copy apart from env files"

    say "Copying from $source ($PROD_BASE/shared) into $PROJECT ($DEPLOY_BASE/shared):"
    for path in "${paths[@]}"; do
        from="$PROD_BASE/shared/$path"

        if [ -e "$from" ]; then
            size="$(du -sh "$from" 2>/dev/null | cut -f1)"
            printf '  %s  %s\n' "${size:-?}" "$path"
        else
            printf '  -  %s (missing in %s; the slot keeps its own)\n' "$path" "$source"
        fi
    done | rail

    if [ "$yes" -eq 0 ]; then
        is_terminal || fail "not a terminal, so copy-from cannot ask; add --yes to copy"

        if ! ask_yes "Copy these into $PROJECT? Its files are replaced"; then
            say "Nothing copied"

            return
        fi
    fi

    acquire_lock copy-from
    ACTION=copy-from
    LOG_RELEASE="$(current_release)"
    STAGE=copy
    require_free_space copying
    mkdir -p "$DEPLOY_BASE/shared"

    local copied=()
    for path in "${paths[@]}"; do
        from="$PROD_BASE/shared/$path"
        to="$DEPLOY_BASE/shared/$path"

        if [ ! -e "$from" ]; then
            warn "$path is missing in $source; the slot keeps its own"
            continue
        fi

        STAGE="copy $path"
        mkdir -p "$(dirname "$to")"
        COPY_TMP="$to.copy-from.$$"
        old="$to.old.$$"
        rm -rf "$COPY_TMP" "$old"
        cp -a "$from" "$COPY_TMP" || fail "could not copy $path; the slot's $path is unchanged"

        # A folder cannot be renamed over another, so the old one moves aside first.
        if [ -d "$to" ]; then
            mv "$to" "$old"
            mv "$COPY_TMP" "$to" || { mv "$old" "$to"; fail "could not put $path in place; the slot's $path is unchanged"; }
            rm -rf "$old"
        else
            mv -f "$COPY_TMP" "$to" || fail "could not put $path in place; the slot's $path is unchanged"
        fi

        COPY_TMP=""
        copied+=("$path")
        say "Copied $path"
    done

    log_event copy-from "$LOG_RELEASE" "ok, from $source: $(join_notes ${copied[@]+"${copied[@]}"})"
    ACTION=""
    say "Copied into $PROJECT: $(join_notes ${copied[@]+"${copied[@]}"})"
}

# Deploys slot $1 for `slots update`, in a subshell of its own. A plain deploy skips a branch with
# nothing new.
slot_update() {
    # A subshell does not keep the traps, and on_exit must free the slot's lock.
    trap on_exit EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    INTRO=0
    DEPLOY_SLOT="$1"
    apply_slot
    deploy
}

# Redeploys every slot whose branch has new commits, for cron; a free slot follows DEPLOY_BRANCH. A
# slot whose branch is gone from the repo is skipped. A failing slot does not stop the others, but the run then exits with 1.
slots_update() {
    local i slot label before after code result rows="" failed=0

    require_slots "slots update"
    read_slot_branches

    for ((i = 1; i <= STAGING_SERVERS; i++)); do
        slot="s$i"
        IFS=$'\t' read -r _ label before _ <<< "$(slot_row "$slot")"

        # A free slot never deployed gets its first release too.
        [ "$label" != free ] || label="free ($DEPLOY_BRANCH)"

        if [ "${SLOT_GONE[$((i - 1))]}" -eq 1 ]; then
            warn "$PROJECT@$slot: $label is gone from the repo; skipped (deploy $PROJECT@$slot free, or stage another branch)"
            rows+="$slot"$'\t'"$label"$'\t'"branch gone"$'\n'
            continue
        fi

        say "Updating $PROJECT@$slot ($label)"
        set +e
        (
            set -e
            slot_update "$slot"
        )
        code=$?
        set -e
        IFS=$'\t' read -r _ _ after _ <<< "$(slot_row "$slot")"

        if [ "$code" -ne 0 ]; then
            result="failed"
            failed=$((failed + 1))
        elif [ "$before" = "$after" ]; then
            result="unchanged"
        elif [ "$before" = - ]; then
            result="deployed, $after"
        else
            result="updated, $before to $after"
        fi

        rows+="$slot"$'\t'"$label"$'\t'"$result"$'\n'
    done

    say "Summary"

    if command -v column > /dev/null; then
        printf '%s' "$rows" | column -t -s $'\t' | rail
    else
        printf '%s' "$rows" | rail
    fi

    [ "$failed" -eq 0 ] || fail "$failed slot(s) failed to update"
}

check_all() {
    local project failed=0 status

    for project in $(list_projects); do
        # Not in a condition, which would turn `set -e` off in check and health().
        set +e
        (
            set -e
            load_project "$project"
            apply_defaults
            check
        )
        status=$?
        set -e
        [ "$status" -eq 0 ] || failed=1
    done

    [ -n "$(list_projects)" ] || fail "no projects in $PROJECTS_DIR (copy example.env)"

    return "$failed"
}

move_to_shared() {
    local from="$1" to="$2" dry_run="$3"

    if [ -e "$to" ]; then
        say "Keeping existing ${to#"$DEPLOY_BASE"/}"

        return
    fi

    [ -e "$from" ] || fail "$from is missing"

    if [ "$dry_run" -eq 1 ]; then
        say "Would move $from to $to and link it back"

        return
    fi

    mkdir -p "$(dirname "$to")"
    mv "$from" "$to"
    ln -s "$to" "$from"
    say "Moved $from to $to"
}

init() {
    local checkout="${1:-}" dry_run=0 path

    [ -n "$checkout" ] || fail "usage: deploy [project] init <checkout> [--dry-run]"
    [ -d "$checkout" ] || fail "$checkout is not a folder"
    checkout="$(cd "$checkout" && pwd -P)"

    if [ "${2:-}" = --dry-run ]; then
        dry_run=1
    elif [ -n "${2:-}" ]; then
        fail "unknown option $2"
    fi

    [ -f "$checkout/deploy.conf" ] || fail "$checkout has no deploy.conf; update it to a commit that has one"

    resolve_base

    # Only SHARED is needed, so the steps are not loaded into this shell.
    local shared
    # shellcheck source=/dev/null
    shared="$(SHARED=() && . "$checkout/deploy.conf" && printf '%s\n' ${SHARED[@]+"${SHARED[@]}"})"

    while IFS= read -r path; do
        [ -n "$path" ] || continue
        check_shared_path "$path"
        move_to_shared "$checkout/$path" "$DEPLOY_BASE/shared/$path" "$dry_run"
    done <<< "$shared"

    if [ "$dry_run" -eq 0 ]; then
        mkdir -p "$DEPLOY_BASE/releases"
    fi

    cat <<EOF

Next steps:
  1. Deploy the first release: deploy ${PROJECT:-<project>}
     (REPO_URL must be set for it: $(redact "$(git -C "$checkout" remote get-url origin 2>/dev/null || printf 'the repo URL')"))
  2. Point the web root at $DEPLOY_BASE/current/public (or replace it with a link to it).
  3. Point cron at $DEPLOY_BASE/current.
EOF
}

# Shows the values in effect, so env overrides (e.g. from a shell profile) are visible.
# Updates the engine itself: a fast-forward pull of its own checkout.
self_update() {
    local before after from_version tags

    git -C "$ENGINE_DIR" rev-parse --git-dir > /dev/null 2>&1 || fail "$ENGINE_DIR is not a git checkout"
    before="$(git -C "$ENGINE_DIR" rev-parse HEAD)"
    from_version="$(engine_version)"

    say "Updating the engine in $ENGINE_DIR"
    git -C "$ENGINE_DIR" pull --quiet --ff-only \
        || fail "could not update $ENGINE_DIR; it may have local changes or a branch that moved apart"
    after="$(git -C "$ENGINE_DIR" rev-parse HEAD)"

    if [ "$before" = "$after" ]; then
        say "Already up to date ($(engine_version))"

        return
    fi

    say "Updated $from_version → $(engine_version)"
    tags="$(git -C "$ENGINE_DIR" tag --list 'v[0-9]*' --sort=v:refname --merged "$after" --no-merged "$before")"

    if [ -z "$tags" ] && [ -z "$(git -C "$ENGINE_DIR" tag --list 'v[0-9]*')" ]; then
        git -C "$ENGINE_DIR" log --format='    %h %s' "$before..$after" | rail

        return
    fi

    self_update_notes "$before" "$after" "$tags" | rail
}

# What changed: each new tag with its GitHub release notes (or its commits when gh cannot read
# them), then the commits past the last tag.
self_update_notes() {
    local from="$1" after="$2" tags="$3" tag notes commits

    for tag in $tags; do
        printf '%s\n' "$tag"
        notes=""

        if command -v gh > /dev/null; then
            notes="$(cd "$ENGINE_DIR" && GH_PROMPT_DISABLED=1 gh release view "$tag" --json body --jq .body \
                2>/dev/null | tr -d '\r')" || notes=""
        fi

        if [ -n "$notes" ]; then
            printf '%s\n' "$notes" | sed 's/^/    /'
        else
            git -C "$ENGINE_DIR" log --no-merges --format='    %h %s' "$from..$tag"
        fi

        from="$tag"
    done

    commits="$(git -C "$ENGINE_DIR" log --no-merges --format='    %h %s' "$from..$after")"
    [ -z "$commits" ] || printf 'Not released yet\n%s\n' "$commits"
}

# The engine's history, newest first: commits not pulled yet, then the last installed ones.
self_log() {
    local count="${1:-10}" tz="${DISPLAY_TZ:-}" first upstream="" new

    [[ "$count" =~ ^[0-9]+$ ]] || fail "usage: deploy self log [count]"
    git -C "$ENGINE_DIR" rev-parse --git-dir > /dev/null 2>&1 || fail "$ENGINE_DIR is not a git checkout"

    # Times in the first project's DISPLAY_TZ, like the project logs.
    first="$(list_projects | sed -n 1p)"

    if [ -z "$tz" ] && [ -n "$first" ]; then
        tz="$(load_project "$first" && printf '%s' "${DISPLAY_TZ:-}")" || tz=""
    fi

    if git -C "$ENGINE_DIR" fetch --quiet 2>/dev/null; then
        upstream="$(git -C "$ENGINE_DIR" rev-parse --verify --quiet '@{upstream}' || true)"
    fi

    if [ -n "$upstream" ]; then
        new="$(TZ="${tz:-UTC}" git -C "$ENGINE_DIR" log --no-merges --format='  %h  %ad  %s' \
            --date='format-local:%Y-%m-%d %H:%M %Z' "HEAD..$upstream")"
        [ -z "$new" ] || printf 'Not pulled yet (run: deploy self):\n%s\n\n' "$new"
    fi

    printf 'Installed in %s:\n' "$ENGINE_DIR"
    TZ="${tz:-UTC}" git -C "$ENGINE_DIR" log --no-merges -n "$count" --format='  %h  %ad  %s' \
        --date='format-local:%Y-%m-%d %H:%M %Z' HEAD
}

# The help block of command $1, as the full usage shows it: its forms on the left, what they do on
# the right.
# The only project with staging slots. Fails when none or several have them.
only_staging_project() {
    local name count found=()

    for name in $(list_projects); do
        count="$(load_project "$name" && printf '%s' "${STAGING_SERVERS:-0}")"

        case "$count" in
            '' | *[!0-9]*) ;;
            *) [ $((10#$count)) -eq 0 ] || found+=("$name") ;;
        esac
    done

    case ${#found[@]} in
        1) printf '%s' "${found[0]}" ;;
        0) fail "no project has staging slots (set STAGING_SERVERS in $PROJECTS_DIR/<project>.env)" ;;
        *) fail "name a project: deploy staging <project> (projects with slots: ${found[*]})" ;;
    esac
}

# Turns `staging [project[@sN]] [command] [args]` into the old form, in STAGING_ARGS.
staging_args() {
    local target sub branch="" pr="" flags=() usage

    if [ $# -gt 0 ] && is_project "$1"; then
        target="$1"
        shift
    elif [ "${1:-}" != "${1%@*}" ]; then
        fail "no project named ${1%%@*} (projects: $(list_projects | paste -sd ' ' -))"
    else
        target="$(only_staging_project)"
    fi

    sub="${1:-}"
    [ $# -eq 0 ] || shift

    case "$sub" in
        "")
            if [ "$target" = "${target%@*}" ]; then
                STAGING_ARGS=("$target" slots)
            else
                STAGING_ARGS=("$target" status)
            fi
            ;;
        checkout)
            if [ "$target" = "${target%@*}" ]; then
                STAGING_ARGS=("$target" stage "$@")

                return
            fi

            usage="usage: deploy staging $target checkout <branch> | --pr <number>"

            while [ $# -gt 0 ]; do
                case "$1" in
                    --pr)
                        [ $# -gt 1 ] || fail "$usage"
                        pr="$2"
                        shift
                        ;;
                    --pr=*) pr="${1#--pr=}" ;;
                    -*) flags+=("$1") ;;
                    *)
                        [ -z "$branch" ] || fail "$usage"
                        branch="$1"
                        ;;
                esac
                shift
            done

            if [ -z "$branch$pr" ] || { [ -n "$branch" ] && [ -n "$pr" ]; }; then
                fail "$usage"
            fi

            if [ -n "$pr" ]; then
                STAGING_ARGS=("$target" --pr "$pr")
            else
                STAGING_ARGS=("$target" --branch "$branch")
            fi

            STAGING_ARGS+=(${flags[@]+"${flags[@]}"})
            ;;
        update)
            if [ "$target" != "${target%@*}" ]; then
                STAGING_ARGS=("$target" deploy "$@")
            else
                [ $# -eq 0 ] || fail "update of all slots takes no options; name one slot for those: deploy staging $target@sN update $*"
                STAGING_ARGS=("$target" slots update)
            fi
            ;;
        free | copy-from | status | log | path | rollback | down | up)
            [ "$target" != "${target%@*}" ] || fail "$sub works on one slot: deploy staging $target@sN $sub"
            STAGING_ARGS=("$target" "$sub" "$@")
            ;;
        *)
            unknown_command "$sub" staging
            ;;
    esac
}

command_help() {
    local name

    case "$1" in
        deploy)
            cat <<EOF
  deploy [--ref <ref>] [--force] [--no-wait] [--yes]
                             Build the newest commit and switch to it (the default). Stops if
                             that commit is already live, unless --force; on a terminal --force
                             asks first, and --yes skips that. --ref deploys a tag, branch or
                             commit instead. A commit under 5 minutes old waits for its release
                             tag, unless --no-wait or --ref
  deploy --branch <name>     On a slot only: follow that branch from now on and deploy it. A
                             plain deploy of the slot then deploys the newest commit of it
  deploy --pr <number>       On a slot only: follow the head of that pull request, the same way.
                             Plain git, no GitHub token
EOF
            ;;
        freeze)
            cat <<EOF
  freeze [reason]            Refuse deploys and rollbacks until unfreeze, showing the reason
EOF
            ;;
        unfreeze)
            cat <<EOF
  unfreeze                   Allow deploys again
EOF
            ;;
        down)
            cat <<EOF
  down [reason] [--yes]      Run the down() step of the live release, like a maintenance page.
                             Deploys and check skip the site check until up. Asks first on a
                             terminal; --yes skips that
EOF
            ;;
        up)
            cat <<EOF
  up                         Run the up() step and check the site again
EOF
            ;;
        status)
            cat <<EOF
  status                     Show the live release, the rollback target, pending commits, all
                             releases, the disk and the site
  status --all               One line per project, and one for the engine; fails if any site does
                             not serve its live release. Production only, no slots
EOF
            ;;
        check)
            cat <<EOF
  check                      Check the live release, its shared links, its health() step, the
                             site, the disk (DISK_LIMIT, MIN_FREE_MB) and the lock; changes
                             nothing. Problems go to stderr; exits with 1 on any
  check --all                The same for every project, production only
EOF
            ;;
        log)
            cat <<EOF
  log [count]                The last deploys and rollbacks, with results (20 by default)
EOF
            ;;
        path)
            cat <<EOF
  path [--base]              Print the full path of the live release, or of DEPLOY_BASE with
                             --base, and nothing else: cd "\$(deploy path <project>)"
EOF
            ;;
        rollback)
            cat <<EOF
  rollback [name] [--yes]    Point current at the previous good release and mark the live one
                             bad, or go to the named release (a full name or a unique part of
                             it, like the sha or tag). Asks first on a terminal; --yes skips that
EOF
            ;;
        slots)
            cat <<EOF
  slots                      One line per staging slot: its branch (PR #N, or free (DEPLOY_BRANCH);
                             "(gone)" when the repo no longer has it), live commit, deploy time
                             and URL
  slots update               Redeploy each slot whose branch has new commits, for cron; a free
                             slot follows DEPLOY_BRANCH, even one never deployed. Skips a slot
                             whose branch is gone from the repo. Exits with 1 if any slot failed
EOF
            ;;
        stage)
            cat <<EOF
  stage <branch>, stage --pr <number>
                             Deploy to the slot that already follows it, else to the first free
                             one, else to one whose branch is gone, and print the slot's URL
                             last. Fails when all slots are busy
EOF
            ;;
        free)
            cat <<EOF
  free                       On a slot only: forget its branch, so stage can use it, and deploy
                             the newest DEPLOY_BRANCH. A plain deploy of a free slot does the
                             same, and the slot stays free
EOF
            ;;
        copy-from)
            cat <<EOF
  copy-from <project> [--yes] [path ...]
                             On a slot only: copy production's SHARED data into the slot's
                             shared/, all paths but .env, or only the named ones. Asks first;
                             --yes skips that, and without a terminal it is required
EOF
            ;;
        staging)
            cat <<EOF
  staging [project]          List the staging slots (like slots). Without a project: the only
                             project with slots
  staging <project>@sN       Show the slot's status
EOF
            for name in "${STAGING_COMMANDS[@]}"; do
                command_help "staging $name"
            done
            ;;
        "staging checkout")
            cat <<EOF
  staging <project> checkout <branch> | --pr <number>
                             Deploy to the slot that already follows it, else to the first free
                             one, else to one whose branch is gone, and print the slot's URL
                             last (like stage)
  staging <project>@sN checkout <branch> | --pr <number> [--force] [--yes]
                             Make this slot follow that branch or pull request, and deploy it
                             (like <project>@sN --branch, --pr)
EOF
            ;;
        "staging update")
            cat <<EOF
  staging <project>@sN update [--force] [--no-wait] [--yes]
                             Deploy the newest commit of the slot's branch (like a plain deploy
                             of the slot)
  staging <project> update   Redeploy each slot whose branch has new commits (like slots update)
EOF
            ;;
        "staging free")
            cat <<EOF
  staging <project>@sN free  Forget the slot's branch and deploy the newest DEPLOY_BRANCH
EOF
            ;;
        "staging copy-from")
            cat <<EOF
  staging <project>@sN copy-from <project> [--yes] [path ...]
                             Copy production's SHARED data into the slot, all paths but .env
EOF
            ;;
        "staging status")
            cat <<EOF
  staging <project>@sN status
                             Show the slot's status
EOF
            ;;
        "staging log")
            cat <<EOF
  staging <project>@sN log [count]
                             The slot's last deploys and rollbacks
EOF
            ;;
        "staging path")
            cat <<EOF
  staging <project>@sN path [--base]
                             Print the full path of the slot's live release
EOF
            ;;
        "staging rollback")
            cat <<EOF
  staging <project>@sN rollback [name] [--yes]
                             Roll the slot back to its previous good release, or to the named one
EOF
            ;;
        "staging down")
            cat <<EOF
  staging <project>@sN down [reason] [--yes]
                             Run the down() step of the slot's live release
EOF
            ;;
        "staging up")
            cat <<EOF
  staging <project>@sN up    Run the slot's up() step and check its site again
EOF
            ;;
        init)
            cat <<EOF
  init <checkout> [--dry-run]
                             Move the SHARED paths of an existing checkout into shared/
EOF
            ;;
        self)
            cat <<EOF
  self-update, self          Update the engine: git pull in $ENGINE_DIR, then show the new
                             versions and their release notes
  self log [count]           The engine's last commits (10 by default), and ones not pulled yet
EOF
            ;;
        help)
            cat <<EOF
  help [command]             Show this help, or only the help of one command, like
                             <command> --help and <command> -h
EOF
            ;;
        version)
            cat <<EOF
  --version, version         The engine's version: its newest release tag
EOF
            ;;
    esac
}


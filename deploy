# The help of one command: its usage line, its block of the full usage, and examples.
command_usage() {
    local block form prefix="[project] "
    block="$(command_help "$1")"
    # The first form of the block, without its text.
    form="$(printf '%s\n' "$block" | sed -E '1!d; s/^ +//; s/ {2,}.*$//')"

    case "$1" in
        self | help | version | staging*) prefix="" ;;
        free | copy-from) prefix="<project>@sN " ;;
    esac

    printf 'Usage: deploy %s%s\n\n%s\n\nExamples:\n' "$prefix" "$form" "$block"
    command_examples "$1" | sed 's/^/  /'
}

is_command() {
    is_one_of "$1" "${COMMANDS[@]}"
}

# True when $1 is one of $2...
is_one_of() {
    local word="$1" name
    shift

    for name in "$@"; do
        [ "$name" != "$word" ] || return 0
    done

    return 1
}

# The topic of `deploy [project] <command> --help` (or -h) and `deploy [project] help <topic>`, as
# named in COMMANDS, or "staging <subcommand>". Nothing for the full help or a run that is not a
# help request.
help_topic() {
    local command arg

    if [ $# -gt 0 ] && is_project "$1"; then
        shift
    fi

    command="${1:-deploy}"
    [ $# -eq 0 ] || shift

    case "$command" in
        help | -h | --help)
            command="$(command_name "${1:-}")"
            [ "$command" != staging ] || [ -z "${2:-}" ] || command="staging $2"
            printf '%s' "$command"

            return
            ;;
    esac

    command="$(command_name "$command")"
    is_command "$command" || return 0

    if [ "$command" = staging ]; then
        [ $# -eq 0 ] || ! is_project "$1" || shift

        case "${1:-}" in
            "" | -*) ;;
            *) command="staging $1" ;;
        esac
    fi

    for arg in "$@"; do
        case "$arg" in
            -h | --help)
                printf '%s' "$command"

                return
                ;;
        esac
    done
}

# The name in COMMANDS for $1: deploy for its options, self for self-update, version for --version.
command_name() {
    case "$1" in
        --force | --no-wait | --ref | --ref=* | --branch | --branch=* | --pr | --pr=* | --yes | -y) printf deploy ;;
        self-update) printf self ;;
        --version) printf version ;;
        *) printf '%s' "$1" ;;
    esac
}

# The edit distance (Levenshtein) of $1 and $2.
edit_distance() {
    local a="$1" b="$2" i j cost best prev=() cur=()

    for ((j = 0; j <= ${#b}; j++)); do
        prev[j]=$j
    done

    for ((i = 1; i <= ${#a}; i++)); do
        cur=("$i")

        for ((j = 1; j <= ${#b}; j++)); do
            cost=1
            [ "${a:i-1:1}" != "${b:j-1:1}" ] || cost=0
            best=$((prev[j] + 1))
            [ $((cur[j - 1] + 1)) -ge "$best" ] || best=$((cur[j - 1] + 1))
            [ $((prev[j - 1] + cost)) -ge "$best" ] || best=$((prev[j - 1] + cost))
            cur[j]=$best
        done

        prev=("${cur[@]}")
    done

    printf '%s' "${prev[${#b}]}"
}

# The name in $2... closest to $1: one that starts with it, else one at most 1 edit away (2 for a
# name of 5 letters or more). Nothing when none is close.
closest_command() {
    local word="$1" name distance best="" best_distance=3 limit=1
    shift

    [ ${#word} -lt 5 ] || limit=2

    for name in "$@"; do
        if [ ${#word} -ge 2 ] && [ "${name#"$word"}" != "$name" ]; then
            printf '%s' "$name"

            return
        fi
    done

    for name in "$@"; do
        distance="$(edit_distance "$word" "$name")"

        if [ "$distance" -le "$limit" ] && [ "$distance" -lt "$best_distance" ]; then
            best="$name"
            best_distance="$distance"
        fi
    done

    printf '%s' "$best"
}

# One line with the closest command, and where to find the rest. Exits with 2, like a usage error.
# With $2 = staging, for a staging subcommand.
unknown_command() {
    local guess

    if [ "${2:-}" = staging ]; then
        guess="$(closest_command "$1" "${STAGING_COMMANDS[@]}")"
        error_line "Unknown staging command: $1.${guess:+ Did you mean $guess?}"
        printf 'Run deploy staging --help to see all staging commands.\n' >&2
    else
        guess="$(closest_command "$1" "${COMMANDS[@]}")"
        error_line "Unknown command: $1.${guess:+ Did you mean $guess?}"
        printf 'Run deploy help to see all commands.\n' >&2
    fi

    exit 2
}

usage() {
    local projects name
    projects="$(list_projects | paste -sd ' ' -)"

    cat <<EOF
Usage: deploy [project] [command]

Projects (in $PROJECTS_DIR): ${projects:-none yet; copy example.env}
The project can be left out when there is only one. A staging slot is named <project>@sN
(tarasov@s1) and takes the same commands, with its own folder, URL and branch.

Staging:
EOF

    command_help staging
    printf '\nCommands:\n'

    for name in "${COMMANDS[@]}"; do
        [ "$name" = staging ] || command_help "$name"
    done

    cat <<EOF

Settings${PROJECT:+ for $PROJECT} (value now in effect):
  DEPLOY_BASE     Folder with releases/, shared/ and current (${DEPLOY_BASE:-not set})
  CHECK_URL       Page that must show the new version ($(redact "${CHECK_URL:-not set}"))
  REPO_URL        Repo to clone ($(redact "${REPO_URL:-origin of current}"))
  DEPLOY_BRANCH   Branch to deploy ($DEPLOY_BRANCH)
  KEEP_RELEASES   Releases to keep, 2 or more ($KEEP_RELEASES)
  CHECK_WAIT      Seconds to wait for CHECK_URL ($CHECK_WAIT)
  CHECK_VERSION   0 to only wait for a 200 ($CHECK_VERSION)
  RELEASE_WAIT    Seconds to wait for a new commit's release tag, 0 for none ($RELEASE_WAIT)
  PHP_BIN         PHP binary ($PHP_BIN)
  COMPOSER_BIN    Composer command ($COMPOSER_BIN)
  PHP_RELOAD_CMD  Run after each switch, up to 60 s (${PHP_RELOAD_CMD:-none})
  OPCACHE_RESET_DIR Web root in a release, to reset OPcache through the web after each switch (${OPCACHE_RESET_DIR:-off})
  STEP_TIMEOUT    Seconds a deploy.conf step may run, 0 for no limit ($STEP_TIMEOUT)
  DISK_LIMIT      Max size of the base folder for check, like 2G or 500M (${DISK_LIMIT:-no limit})
  MIN_FREE_MB     Free MB check wants and deploy needs, 0 for off ($MIN_FREE_MB)
  MIGRATIONS_DIR  Folder a rollback compares to warn about missing migrations (${MIGRATIONS_DIR:-off})
  DISPLAY_TZ      Time zone for status times (${DISPLAY_TZ:-UTC})
  NOTIFY_URL      Webhook for alerts, gets JSON with "text" ($([ -n "$NOTIFY_URL" ] && printf set || printf 'not set'))
  NOTIFY_CMD      Command for alerts, text in \$NOTIFY_TEXT ($([ -n "$NOTIFY_CMD" ] && printf set || printf 'not set'))
  NOTIFY_ON       problems, or all to also send successful deploys ($NOTIFY_ON)
  STAGING_SERVERS Staging slots s1..sN, each in <folder of DEPLOY_BASE>/sN ($STAGING_SERVERS)
  STAGING_URL     Slot URL with {slot}; default: sN. before the host of CHECK_URL ($(redact "${STAGING_URL:-not set}"))
EOF
}

# Makes every git call against a remote fail fast on a dead or stalled network: no password
# prompt, a stop when HTTPS moves under 1000 bytes/s for 30 s, and for SSH a 10 s connect timeout
# and a stop after 30 s of silence. Settings the user made win: the git HTTP variables when set, and
# their SSH command keeps its own options, as ssh takes the first value of each.
git_fail_fast() {
    local ssh_cmd

    export GIT_TERMINAL_PROMPT=0
    export GIT_HTTP_LOW_SPEED_LIMIT="${GIT_HTTP_LOW_SPEED_LIMIT:-1000}"
    export GIT_HTTP_LOW_SPEED_TIME="${GIT_HTTP_LOW_SPEED_TIME:-30}"

    # GIT_SSH names a program that may not take ssh options; left alone.
    if [ -z "${GIT_SSH_COMMAND:-}" ] && [ -n "${GIT_SSH:-}" ]; then
        return 0
    fi

    ssh_cmd="${GIT_SSH_COMMAND:-$(git config --get core.sshCommand 2>/dev/null || true)}"
    export GIT_SSH_COMMAND="${ssh_cmd:-ssh} -o ConnectTimeout=10 -o BatchMode=yes -o ServerAliveInterval=10 -o ServerAliveCountMax=3"
}

# Runs only once bash has read the whole file, so a `git pull` of the engine during a run cannot
# change the code that runs.
main() {
    local projects command topic

    # Before a project is loaded: the engine itself, and commands where each project loads its own
    # settings.
    if [ "${1:-}" = --version ] || [ "${1:-}" = version ]; then
        engine_version
        printf '\n'
        exit 0
    fi

    ENGINE_FUNCS="$(compgen -A function)"
    trap on_exit EXIT
    git_fail_fast

    # A signal exits with 128 + its number, so on_exit cleans up once.
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP

    # The help of one command needs no project and runs nothing.
    topic="$(help_topic "$@")"
    if [ -n "$topic" ]; then
        is_command "${topic%% *}" || unknown_command "$topic"
        case "$topic" in
            "staging "*)
                is_one_of "${topic#staging }" "${STAGING_COMMANDS[@]}" || unknown_command "${topic#staging }" staging
                ;;
        esac
        report "help $topic" command_usage "$topic"
        exit 0
    fi

    # `deploy staging ...` runs the old form of each staging command.
    if [ "${1:-}" != staging ] && [ "${2:-}" = staging ] && is_project "$1"; then
        set -- staging "$1" "${@:3}"
    fi
    if [ "${1:-}" = staging ]; then
        shift
        staging_args "$@"
        set -- "${STAGING_ARGS[@]}"
    fi

    if [ "${1:-}" = self-update ] || [ "${1:-}" = self ]; then
        case "${2:-}" in
            "" | update)
                intro "self update"
                self_update
                ;;
            log) report "self log" self_log "${3:-}" ;;
            *) fail "unknown command: deploy $1 $2 (try: deploy self, deploy self log [count])" ;;
        esac

        exit 0
    fi

    if [ "${1:-}" = status ] && [ "${2:-}" = --all ]; then
        report "status --all" status_all
        exit 0
    fi

    if [ "${1:-}" = check ] && [ "${2:-}" = --all ]; then
        report "check --all" check_all
        exit 0
    fi

    # A bare deploy on a terminal picks the project from a menu.
    if [ $# -eq 0 ] && is_terminal && [ -n "$(list_projects)" ]; then
        project_menu
    fi

    # `deploy path <project>` reads like `deploy <project> path`. Its output is only the path, so
    # never on the rails.
    if [ "${1:-}" = path ] && [ $# -gt 1 ] && is_project "$2"; then
        set -- "$2" path "${@:3}"
    fi
    if [ "${1:-}" = path ] || { [ "${2:-}" = path ] && is_project "$1"; }; then
        RAILS=0
    fi

    # The project: the first argument when it names a project file, else the only project there is.
    if [ $# -gt 0 ] && is_project "$1"; then
        load_project "$1"
        shift
    elif [ "$(list_projects | wc -l)" -eq 1 ]; then
        load_project "$(list_projects)"
    fi

    apply_defaults
    [ -z "$DEPLOY_SLOT" ] || apply_slot

    command="$(command_name "${1:-deploy}")"
    case "$command" in
        -h | --help) ;;
        *) is_command "$command" || unknown_command "$1" ;;
    esac

    if [ -z "$PROJECT" ] && [ -z "$DEPLOY_BASE" ] && [ "${1:-deploy}" != help ] \
        && [ "${1:-}" != -h ] && [ "${1:-}" != --help ]; then
        projects="$(list_projects | paste -sd ' ' -)"
        fail "name a project (${projects:-none yet; copy $PROJECTS_DIR/example.env})"
    fi

    case "$command" in
        deploy | freeze | unfreeze | down | up | rollback | init | stage | free | copy-from)
            intro "${PROJECT:+$PROJECT · }$command"
            ;;
        slots)
            [ "${2:-}" != update ] || intro "${PROJECT:+$PROJECT · }slots update"
            ;;
    esac

    case "${1:-deploy}" in
        deploy)
            [ $# -eq 0 ] || shift
            deploy "$@"
            ;;
        --force | --no-wait | --ref | --ref=* | --branch | --branch=* | --pr | --pr=* | --yes | -y)
            deploy "$@"
            ;;
        freeze)
            shift
            freeze "$*"
            ;;
        unfreeze)
            unfreeze
            ;;
        down)
            shift
            maintenance_down "$@"
            ;;
        up)
            maintenance_up
            ;;
        status)
            report "${PROJECT:+$PROJECT · }status" status
            ;;
        check)
            report "${PROJECT:+$PROJECT · }check" check
            ;;
        log)
            resolve_base
            report "${PROJECT:+$PROJECT · }log" show_log "${2:-}"
            ;;
        path)
            show_path "${2:-}"
            ;;
        slots)
            case "${2:-}" in
                "") report "${PROJECT:+$PROJECT · }slots" show_slots ;;
                update) slots_update ;;
                *) fail "unknown command: deploy ${PROJECT:-<project>} slots $2 (try: slots, slots update)" ;;
            esac
            ;;
        stage)
            shift
            stage "$@"
            ;;
        free)
            [ -n "$DEPLOY_SLOT" ] || fail "free works on one slot: deploy ${PROJECT:-<project>}@sN free"
            free_slot
            ;;
        copy-from)
            [ -n "$DEPLOY_SLOT" ] \
                || fail "copy-from copies into a staging slot, never into production: deploy ${PROJECT:-<project>}@sN copy-from ${PROJECT:-<project>}"
            shift
            copy_from "$@"
            ;;
        rollback)
            shift
            rollback "$@"
            ;;
        init)
            init "${2:-}" "${3:-}"
            ;;
        help | -h | --help)
            report help usage
            ;;
        version)
            engine_version
            printf '\n'
            ;;
        self | self-update)
            fail "$1 works on the engine, not on a project: deploy $1"
            ;;
        *)
            unknown_command "$1"
            ;;
    esac
}

# Sourced (by the tests), it only defines the functions.
[ "${BASH_SOURCE[0]}" != "$0" ] || main "$@"
